# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Monorepo-wide patterns (unanchored) so they match under client/, server/, app/.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# builds / output
.next/
out/
build/
dist/

# testing
coverage/

# misc
.DS_Store
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (opt-in commit if ever needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tooling
.gstack/
