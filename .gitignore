# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Monorepo-wide patterns (unanchored) so they match under client/, server/, app/.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# builds / output
.next/
out/
build/
dist/

# testing
coverage/

# misc
.DS_Store
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# test-run output. `server/jest-run.log` was committed once (77c87af) and
# every subsequent test run rewrote it into the diff — a build artefact is
# not a reviewable change.
*.log

# Playwright MCP scratch output (console dumps + page snapshots). Written by
# the browser tool on every run, referenced by nothing in the repo.
.playwright-mcp/

# env files (opt-in commit if ever needed)
.env*
# ...except the templates. These hold only placeholders (the API refuses to
# boot on them in production), and docs/DEPLOY.md sends you to them when
# recreating a box — so a fresh clone needs to actually have them.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tooling
.gstack/
.claude/
.playwright-mcp/

# Verification screenshots — evidence for a specific release, not source.
deploy-*.png
live-*.png

# M26 QA sweep screenshots (local only)
.qa-shots/

# Screenshots of the live admin panel (M36).
#
# They are kept locally for review and MUST NOT be committed: the approval
# queue shows real applicants — their names, their storefront names and at
# least one full email address. This repository is public, so committing a
# screenshot of that screen publishes a stranger's personal data
# permanently.
#
# Same principle the pickup address follows in code (see
# `server/test/unit/vendor-privacy.spec.ts`): the people who applied here
# never agreed to be published.
screenshots-m36/

# Review screenshots taken for a milestone hand-off. Kept out of the
# tree for the same reason as `.qa-shots/`: they are a few megabytes of
# PNG that go stale the next time the UI moves.
review-shots/

# playwright output
test-results/
