# Homekrafted client — environment variables.
# Copy to `.env.local` (gitignored — Next.js convention) and fill in real
# values for local dev. Everything below is a placeholder / dev default.

# --- API ---------------------------------------------------------------
# Base URL of `server/` (NestJS), including its `/api/v1` global prefix —
# see `docs/API.md`'s "Conventions". `server/docker-compose.yml` + `npm run
# start:dev` serve this locally at :4000 by default (`server/.env.example`'s
# PORT).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# --- Razorpay (checkout, M8.2) ------------------------------------------
# Test-mode publishable key id for the Razorpay Checkout SDK
# (`components/checkout/CheckoutClient.tsx`). A placeholder is fine — the
# server degrades `POST /payments/razorpay/order` to a locally-minted mock
# order id whenever `RAZORPAY_KEY_ID`/`_SECRET` are still its own
# `.env.example` placeholders, so the whole flow stays exercisable without
# a real Razorpay account. Get a real `rzp_test_...` key from the Razorpay
# dashboard (Test Mode) to exercise the real Checkout modal.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder

# --- Mock fallback -------------------------------------------------------
# `"true"` reverts every `lib/api/*` domain (except seller/admin, still
# mock pending M8.4b) + AuthContext/CartContext/WalletContext/
# WishlistContext back to the pre-M8.4a in-memory/localStorage mock layer
# — no network calls to NEXT_PUBLIC_API_URL at all. Useful for frontend-only
# work with no `server/` running. Leave unset/"false" to run against the
# live API.
NEXT_PUBLIC_USE_MOCK=false
