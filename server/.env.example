# Homekrafted server — environment variables.
# Copy to `.env` (never committed — see repo root .gitignore's `.env*` rule)
# and fill in real values. Everything below is a placeholder / dev default.

# --- App -------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Web origin allowed to call this API (CORS). Comma-separate for multiple.
CLIENT_ORIGIN=http://localhost:3000

# --- Database ----------------------------------------------------------------
# Standard Postgres connection string. `docker-compose.yml` in this directory
# spins up a local postgres:16 matching these defaults.
DATABASE_URL="postgresql://homekrafted:homekrafted@localhost:5432/homekrafted?schema=public"

# --- Auth / JWT --------------------------------------------------------------
# Generate real secrets with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
JWT_REFRESH_TTL=7d

# --- OTP (phone login) -------------------------------------------------------
# OTP sender goes through the same Twilio-shaped SMS provider as every other
# SMS below (see "SMS" section) — with real Twilio creds set there, OTP
# codes are actually texted; with placeholders left in place, the code is
# still logged to the server console (`[OTP STUB]`) so dev/login flows keep
# working without a real SMS account.
OTP_TTL_SECONDS=300
OTP_LENGTH=6

# --- Razorpay (reserved — wired in M8.2) -------------------------------------
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# --- WhatsApp Cloud API (Meta) — wired in M9 ---------------------------------
# Real go-live: create a Meta app + WhatsApp Business product
# (business.facebook.com/wa/manage), generate a permanent access token
# (System User, `whatsapp_business_messaging` scope), and grab the Phone
# Number ID from the app's WhatsApp > API Setup page. Placeholders below ->
# every outbound send degrades to a **logged stub** (`[WHATSAPP STUB]`),
# same "real code path either way" convention as Razorpay above.
WHATSAPP_TOKEN=placeholder_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=placeholder_phone_number_id
# Graph API version the outbound client calls — bump when Meta deprecates one.
WHATSAPP_API_VERSION=v20.0
# Arbitrary string *you* choose and enter into the Meta App Dashboard's
# webhook subscription form (Meta echoes it back on the GET verification
# handshake) — not issued by Meta, doesn't need to be secret, just needs to
# match on both sides.
WHATSAPP_VERIFY_TOKEN=placeholder_verify_token
# Your Meta App's "App Secret" (App Dashboard > Settings > Basic) — Meta
# signs every webhook delivery's body with this via HMAC-SHA256
# (`X-Hub-Signature-256`). Required for real signature verification; for
# local testing with `curl` you can set this to any string and compute a
# matching HMAC yourself (same "shared secret, not a real account" trick
# `RAZORPAY_WEBHOOK_SECRET` uses — see `server/README.md`).
WHATSAPP_APP_SECRET=placeholder_app_secret
# Optional: name of an approved Message Template (WhatsApp Business
# Manager > Message Templates) for outbound status sends — e.g.
# "order_status_update" with 2 body params (customer name, status line).
# Leave blank to send plain-text session messages instead (works in the
# 24h customer-service window; a template is required for anything sent
# outside it — set this once you've created + had one approved).
WHATSAPP_STATUS_TEMPLATE=

# --- SMS (Twilio-shaped) — wired in M9 ----------------------------------------
# Real go-live: create a Twilio account (twilio.com/console), grab the
# Account SID + Auth Token from the console dashboard, and buy/verify a
# sending number. MSG91 or any other REST SMS provider is a drop-in swap
# behind `SmsProviderService.send` (same base-URL/auth-header shape).
# Placeholders below -> every send degrades to a logged stub (`[SMS STUB]`).
TWILIO_ACCOUNT_SID=placeholder_account_sid
TWILIO_AUTH_TOKEN=placeholder_auth_token
TWILIO_FROM_NUMBER=+10000000000

# --- Email (SendGrid-shaped) — wired in M9 ------------------------------------
# Real go-live: create a SendGrid account (sendgrid.com), generate a
# "Mail Send"-scoped API key, and verify `EMAIL_FROM`'s sending domain
# (Sender Authentication). Placeholder key -> logged stub (`[EMAIL STUB]`).
SENDGRID_API_KEY=placeholder_sendgrid_key
EMAIL_FROM=notifications@homekrafted.example

# --- Rate limiting -----------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
# Tighter limit specifically on auth routes (login/otp/register).
THROTTLE_AUTH_TTL_SECONDS=60
THROTTLE_AUTH_LIMIT=20

# --- Uploads ------------------------------------------------------------
# Image uploads (POST /uploads). `local` writes to disk on this box; adding
# a cloud driver means implementing StorageDriver and registering it in
# UploadsModule — an unrecognised value here fails at boot rather than
# silently falling back.
STORAGE_DRIVER=local
# MUST be outside the git clone: deploys ff-merge and the clone is
# disposable, so anything written inside it can be wiped.
UPLOAD_DIR=/var/lib/homekrafted/uploads
# URL prefix nginx maps to UPLOAD_DIR. Also the prefix stored in the DB.
UPLOAD_PUBLIC_PREFIX=/uploads
UPLOAD_MAX_BYTES=5242880
THROTTLE_UPLOAD_LIMIT=30
THROTTLE_UPLOAD_TTL_SECONDS=60
