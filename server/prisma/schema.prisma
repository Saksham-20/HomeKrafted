// Homekrafted — Prisma schema (M8.0)
//
// Mirrors `client/lib/types/*.ts` field-for-field — that TypeScript module
// is the schema contract (see root CLAUDE.md + docs/DATA-MODEL.md). Modeling
// notes/deviations from the literal TS shape are called out inline; the
// full rationale lives in docs/DATA-MODEL.md's "M8 Prisma mapping" section.
//
// Scope: M8.0 authors every domain model so later milestones (M8.1
// commerce, M8.2 wallet/Razorpay, M8.3 services/roles) only need to add
// endpoints, not tables. Only Auth + Users (+ Address) get real service
// logic in this milestone.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums — one per TS union in lib/types. `@map(...)` is used wherever the
// TS literal isn't a valid Prisma enum identifier (hyphens), so the DB value
// still round-trips to the exact string the frontend contract expects.
// ---------------------------------------------------------------------------

enum UserRole {
  consumer
  seller
  admin
}

enum AuthProvider {
  phone
  email
  google
  apple
}

/// Real auth providers we can actually issue a session for today (M8.0).
/// `AuthProvider` (above) stays the full lib/types union (incl. "apple",
/// not yet wired) — this is the narrower stub-provider set the social
/// login endpoint accepts.
enum SocialProvider {
  google
  apple
}

enum ReviewTargetType {
  product
  vendor
  service
}

enum NotificationChannel {
  sms
  whatsapp
  email
  inapp
}

enum NotificationCategory {
  order
  laundry
  snacks
  wallet
  promo
  account
  /// Meal-subscription lifecycle + dated-menu changes (M37). Transactional
  /// — defaults follow the non-promo shape (whatsapp/email/inapp on).
  meals
}

enum ReferralStatus {
  pending
  joined
  rewarded
}

enum LoyaltyTier {
  bronze
  silver
  gold
  platinum
}

enum SupportChannel {
  chat
  call
  email
}

enum SupportTicketStatus {
  open
  in_progress @map("in-progress")
  resolved
  closed
}

enum SupportSender {
  user
  agent
}

enum CorporateInquiryStatus {
  new
  contacted
  quoted
  closed
}

/// M20. "50 hampers for Diwali clients" and "20 kg of namkeen for a
/// wedding" are different conversations — different lead time, different
/// person, different margin. One field so the queue can be worked in the
/// right order.
enum CorporateOrderType {
  corporate
  bulk
}

/// M20. `draft` is ours; `sent` is the only state a customer can act on.
/// `accepted` and `declined` are theirs, `expired` is the clock's.
enum CorporateQuoteStatus {
  draft
  sent
  accepted
  declined
  expired
}

enum SellerApplicationCategory {
  maker
  baker
  artist
  /// M19 — the common case now that the platform is food-first. Maps to
  /// `VendorType.maker` in `vendorTypeForCategory`; deliberately NOT a new
  /// `VendorType`, since the storefront renders identically and a new type
  /// would churn every discovery surface.
  home_chef
  other
}

enum SellerApplicationStatus {
  new
  reviewing
  waitlisted
  approved
  rejected
}

enum VendorType {
  maker
  baker
  artist
  homekrafted
}

enum DietaryTag {
  vegetarian
  vegan
  gluten_free   @map("gluten-free")
  sugar_free    @map("sugar-free")
  contains_nuts @map("contains-nuts")
}

enum ProductTag {
  Bestseller
  New
  Festive
  Curated
}

/// M20. What sort of thing a listing is.
///
/// `Product` was food-shaped throughout — `dietary`, `ingredients`,
/// `shelfLife`, `storageInstructions`, `isPackaged`, `defaultWeightSku` —
/// because until now everything on the platform was food. "Handcrafted
/// Gifts" (décor, candles, jewellery, art) is not.
///
/// One column rather than a second model, for exactly the reason M18 made a
/// hamper a `Product` instead of its own table: a craft still needs a
/// vendor, photos, price tiers, availability, moderation, reviews, cart,
/// checkout and search. A parallel `CraftProduct` re-derives every one of
/// those and then drifts from them. The food-only fields simply go unused,
/// and the UI branches on this.
enum ProductKind {
  food
  craft
}

/// M20. How far a listing can travel.
///
/// Food is `local`: it is cooked this morning and driven to you, so it is
/// gated on `distanceKm <= Vendor.deliveryRadiusKm` like everything before
/// it. A candle goes in the post, so `national` listings skip the radius
/// filter entirely and show with or without buyer coordinates.
///
/// Explicit rather than derived from `ProductKind`, because a kitchen
/// shipping pickles across India is a real case and deriving it would
/// forbid one.
enum ProductShippingScope {
  local
  national
}

/// The admin's switch on a listing. Read it as a five-state review
/// lifecycle, not a boolean with extras.
///
/// **Every read path must allowlist `active`, never denylist `hidden`.**
/// Before M22 the enum had three members and the public queries said
/// `{ not: 'hidden' }`, which was equivalent. It stopped being equivalent
/// the moment `pending` existed: a denylist would have published every
/// unreviewed listing, turning the approval gate into decoration. If you
/// add a member here, grep for `moderationStatus` and check each filter.
enum ProductModerationStatus {
  /// Submitted, never reviewed, not public. The default for anything
  /// created from M22 on. Pre-M22 rows stay `active` — applying an
  /// approval gate retroactively would delist a live catalogue and take
  /// every kitchen's income with it.
  pending
  /// Reviewed and allowed. The only state a buyer can see.
  active
  /// Reviewed and refused, with a reason in `moderationNote`. Distinct
  /// from `hidden` on purpose: this listing never went live, the
  /// HomeKrafter is expected to fix it and resubmit, and the copy they
  /// read ("we could not approve this yet") is not the copy for something
  /// taken down after it sold.
  rejected
  /// Was live, an admin removed it. Direct links still resolve, because
  /// carts, orders and wishlists already reference it.
  hidden
  /// Under investigation — off the storefront, not yet decided.
  flagged
}

enum GiftWrapStyle {
  kraft
  floral
  festive
  minimal
}

enum RibbonColor {
  gold
  terracotta
  pine
  ivory
}

enum OrderStatus {
  /// M8.1 seam for M8.2 (wallet debit / Razorpay capture): every order
  /// created by `POST /orders` starts here instead of `placed` — an order
  /// now exists in the DB (with stock already decremented + prices
  /// snapshotted) before payment is actually captured. M8.2's payment flow
  /// owns the `pending_payment` -> `placed` transition (or a failure/
  /// cancellation path that restocks) once the wallet debit / Razorpay
  /// charge succeeds — this milestone does not implement that transition.
  /// Not yet in the frontend mock's `OrderStatus` union
  /// (`client/lib/types/marketplace.ts`) — M8.4 must add
  /// `"pending-payment"` there when it swaps `POST /orders` in.
  pending_payment @map("pending-payment")
  placed
  confirmed
  packed
  shipped
  delivered
  cancelled
  returned
}

enum PaymentMethod {
  wallet
  razorpay
  cod
}

enum RefundStatus {
  none
  requested
  processing
  refunded
}

enum WalletTransactionDirection {
  credit
  debit
}

enum WalletTransactionCategory {
  topup
  cashback
  refund
  payment
  referral
  loyalty
  adjustment
}

enum WalletTransactionRefType {
  order
  laundryBooking
  topup
  referral
  loyalty
  support
  mealSubscription
}

enum AutoTopupTrigger {
  below_threshold @map("below-threshold")
  scheduled
}

/// M8.2 — what a `RazorpayOrder` row was opened to pay for: an existing
/// Homekrafted `Order` (amount = `Order.total`, re-read server-side) or a
/// wallet top-up (amount = the shopper's declared top-up amount — safe to
/// accept from the client here because Razorpay itself enforces that only
/// a payment of exactly this order's amount can ever capture against it;
/// the wallet is only ever credited once our own webhook handler verifies
/// the HMAC and reads *this* row's stored `amount`, never anything in the
/// webhook payload).
enum RazorpayOrderPurpose {
  order
  topup
}

enum RazorpayOrderStatus {
  created
  captured
  failed
}

enum LaundryPricingModel {
  per_kg   @map("per-kg")
  per_item @map("per-item")
  per_hour @map("per-hour")
}

enum LaundryBookingStatus {
  scheduled
  picked_up        @map("picked-up")
  in_progress      @map("in-progress")
  out_for_delivery @map("out-for-delivery")
  delivered
  cancelled
}

enum LaundrySubscriptionPlan {
  weekly
  biweekly
  monthly
}

enum SnackCategory {
  savoury
  sweet
  baked
  namkeen
}

enum DietType {
  veg
  non_veg @map("non-veg")
}

/// Which meal of the day a `MealPlan` covers. Deliberately not a free
/// string: the delivery bracket a buyer may pick is derived per meal, and
/// a kitchen offering "lunch" and "Lunch" would split its own capacity.
enum MealType {
  breakfast
  lunch
  dinner
}

/// `paused` is the buyer's own hold and is reversible; `cancelled` is
/// terminal and `expired` is what a cycle running out of meals becomes.
/// Kept apart because only `paused` should still occupy a kitchen's
/// capacity — somebody away for a week has not given up their seat.
enum MealSubscriptionStatus {
  active
  paused
  cancelled
  expired
}

/// One row per meal a subscription owes. `skipped` is the buyer saying
/// "not tomorrow"; `unavailable` is the kitchen being closed that day.
/// Both return the meal to the cycle, but only one is the buyer's doing,
/// and a kitchen's reliability cannot be read off a column that conflates
/// them.
enum MealDeliveryStatus {
  scheduled
  skipped
  unavailable
  delivered
  cancelled
}

enum SnackListStatus {
  draft
  sent
  received
  accepted
  out_for_delivery @map("out-for-delivery")
  delivered
}

enum SnackOrderStatus {
  received
  accepted
  out_for_delivery @map("out-for-delivery")
  delivered
}

/// `SnackOrder.channel` is a one-value union in lib/types ("whatsapp") —
/// kept as its own enum (not a boolean) so a future channel is a value
/// addition, not a shape change, per that type's own doc comment.
enum SnackOrderChannel {
  whatsapp
}

/// What a HomeKrafter makes or offers. This is a **discovery/display tag,
/// not a role** — every HomeKrafter has the same single role and the same
/// full set of portal modules. Nothing in `server/src/seller/*` may branch
/// on this to decide access; it exists so buyers can filter ("show me
/// bakers near me") and so a kitchen can say what it does.
/// What a HomeKrafter makes — a **discovery/display tag that must never
/// decide access** (see `CLAUDE.md`, M12). One supply role, every portal
/// module, for everyone.
///
/// **M22 widened it, because the taxonomy was food-first and the
/// marketplace is not.** Five of the eight original members were food and
/// exactly one — `crafts` — carried the entire non-food half of a
/// platform that sells everything homemade. A candle maker, a potter, a
/// jeweller and an illustrator were the same tag, which meant no buyer
/// could filter between them and no applicant could say what they made.
///
/// **Existing `crafts` rows were deliberately not remapped.** There is no
/// way to know whether a given one pours candles or throws pots, and a
/// guess would print the wrong thing on a real person's storefront.
/// `crafts` stays valid, relabelled "Other handmade", and those sellers
/// can re-pick.
///
/// `laundry`/`cleaning` belong to the module withdrawn in M19. They stay
/// for the same reason the models do: seeded rows carry them, and the DTO
/// still accepts them because narrowing an accepted request value breaks
/// the native apps, which have no versioning policy behind them.
enum SellerSpecialty {
  // --- food ---
  homemade_food
  bakery
  pickles_preserves
  snacks
  sweets
  beverages

  // --- everything else homemade (M22) ---
  candles
  ceramics
  textiles
  jewellery
  art_prints
  bath_body
  stationery
  home_decor
  personalised
  /// Pre-M22 catch-all, kept readable. Now means "other handmade".
  crafts

  // --- withdrawn module (M19), kept so existing rows resolve ---
  laundry
  cleaning
}

enum SellerStatus {
  pending
  approved
  suspended
}

enum PayoutStatus {
  pending
  paid
  /// M15. A HomeKrafter could request a payout since M8.3b, but nothing
  /// could ever settle or refuse one — there was no admin surface at all,
  /// so `pending` was a terminal state in practice. Rejection needs to be
  /// expressible (wrong bank details, an account under review) without
  /// deleting the request and losing the record that it was made.
  rejected
}

// ---------------------------------------------------------------------------
// Shared / account layer
// ---------------------------------------------------------------------------

/// Modeling note: lib/types' `User.walletId`/`User.loyaltyAccountId` (FKs
/// pointing "down" to Wallet/LoyaltyAccount, which themselves also carry
/// `userId`) collapse into a single Prisma-idiomatic 1:1 relation each,
/// declared from the Wallet/LoyaltyAccount side — no redundant bidirectional
/// FK. `authProviders`/`role`/etc. map straight across.
/// M47 — what a *part-time* admin may reach.
///
/// One value per section of the admin panel, because that is the unit an
/// operator is actually given: "you handle the review queue", "you settle
/// payouts". A finer-grained permission (per endpoint, per verb) reads as
/// more rigorous and is unusable — nobody can hold thirty checkboxes in
/// their head, so in practice everybody gets all thirty ticked and the
/// system means nothing.
///
/// **An admin with an empty list can reach nothing.** That is deliberate
/// and it is the reason the M47 migration backfills every existing admin
/// with the full set: the alternative — empty meaning "everything" —
/// gives a newly created sub-admin the whole panel whenever somebody
/// forgets to tick a box, which is the failure that does not announce
/// itself.
enum AdminScope {
  /// Listings, the review queue, collections and occasions.
  catalog
  /// HomeKrafter applications, approval, verification, coordinates.
  sellers
  /// Order queue, status overrides, shipments.
  orders
  /// Tickets, disputes, returns.
  support
  /// Wallet adjustments, refunds, payouts. The money scope.
  finance
  /// The user list, suspension, and granting these scopes.
  users
  /// Platform settings, including the commission switch.
  settings
  /// Dashboard, analytics, reports, exports.
  analytics
}

model User {
  id                   String         @id @default(cuid())
  name                 String
  email                String?        @unique
  phone                String?        @unique
  /// Only set for the email+password auth flow; null for phone-OTP-only or
  /// social-only accounts.
  passwordHash         String?
  /// The credential in `passwordHash` was issued *to* this person by
  /// somebody else, and must be replaced before the account can be used
  /// (M32).
  ///
  /// Set when an admin mints a temporary password for a newly approved
  /// HomeKrafter — the only case where a second person has ever known a
  /// working credential for this account. It is enforced server-side in
  /// `JwtAuthGuard`, not merely prompted for in the UI: a forced rotation
  /// that a client can skip is decoration, and the whole point is that
  /// the admin-known password stops working the moment its owner arrives.
  /// Cleared by `POST /auth/password/change`, which also revokes every
  /// other session — including any the admin might hold.
  mustChangePassword   Boolean        @default(false)
  /// When a temporary password was last issued (M32, plaintext storage
  /// removed in M37) — drives "approved but never signed in" in the admin
  /// queue. The plaintext itself exists only in the HTTP response of the
  /// issue/approve call; losing it means re-issuing, never re-reading.
  tempPasswordIssuedAt DateTime?
  /// First time this account replaced an issued credential with its own
  /// (M32) — i.e. the moment it really onboarded, as opposed to the
  /// moment an admin approved it.
  credentialsClaimedAt DateTime?
  /// Has the address/number been proved to belong to this person (M25)?
  ///
  /// **Not a sign-in gate, deliberately.** OTP delivery needs Twilio and
  /// SendGrid keys that are not set yet (`docs/LAUNCH-READINESS.md`), so
  /// requiring a verified contact to use an account would lock out every
  /// real signup on day one. These record what has been proved so the
  /// prompts, and later any action worth gating, have something true to
  /// read. Rows created before M25 were backfilled to `true`: they had no
  /// way to verify, and marking real accounts unverified retroactively is
  /// a nag with nothing behind it.
  emailVerified        Boolean        @default(false)
  phoneVerified        Boolean        @default(false)
  avatarPlaceholder    String?
  authProviders        AuthProvider[]
  createdAt            DateTime       @default(now())
  role                 UserRole       @default(consumer)
  /// M47 — which parts of the admin panel this admin may reach.
  ///
  /// Only consulted when `role` is `admin`; ignored otherwise, so a
  /// consumer with a stray value here gains nothing (the role check runs
  /// first, and every admin route still carries `@Roles('admin')`).
  ///
  /// **Empty means nothing, not everything.** Every existing admin was
  /// backfilled with the full set by the M47 migration precisely so this
  /// could be the safe direction: "empty is everything" hands the whole
  /// panel to any sub-admin whose scopes somebody forgot to tick, and
  /// that failure does not announce itself.
  ///
  /// A `users`-scoped admin is the one who grants these — which makes it
  /// the scope to hand out last.
  adminScopes          AdminScope[]
  /// M11a admin suspend/reactivate flag — see lib/types/shared.ts's doc
  /// comment. Unlike the M0–M11a mock, this DOES gate sign-in for real
  /// once wired (auth.service checks it) — that's the real-backend upgrade
  /// the frontend note calls out as still owed.
  suspended            Boolean        @default(false)
  referralCode         String         @unique
  referredByCode       String?

  wallet                  Wallet?
  loyaltyAccount          LoyaltyAccount?
  addresses               Address[]
  reviews                 Review[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  referralsSent           Referral[]               @relation("ReferralsSent")
  referralsReceived       Referral[]               @relation("ReferralsReceived")
  supportTickets          SupportTicket[]
  cart                    Cart?
  wishlist                Wishlist?
  hampers                 Hamper[]
  orders                  Order[]
  laundryBookings         LaundryBooking[]
  laundrySubscriptions    LaundrySubscription[]
  snackLists              SnackList[]
  mealSubscriptions       MealSubscription[]
  seller                  Seller?
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  socialAccounts          SocialAccount[]
  vendorFollows           VendorFollow[]
  razorpayOrders          RazorpayOrder[]
  corporateQuotes         CorporateQuote[]         @relation("CorporateQuoteCreatedBy")
  adminAuditLogs          AdminAuditLog[]
  /// M22 catalogue review. Named relations because a `User` can be the
  /// moderator of three different things and Prisma cannot tell them
  /// apart otherwise.
  moderatedProducts       Product[]                @relation("ProductModerator")
  moderatedMealPlans      MealPlan[]               @relation("MealPlanModerator")
  moderatedSnacks         Snack[]                  @relation("SnackModerator")
  /// Payouts this admin settled or refused — see `Payout.decidedById`.
  payoutDecisions         Payout[]                 @relation("PayoutDecidedBy")
  /// M50 — shelves and occasions asked for, and decided on. Named for the
  /// same reason as the moderator relations above: one `User` can be both.
  taxonomySuggestions     TaxonomySuggestion[]     @relation("TaxonomySuggestionAuthor")
  taxonomyDecisions       TaxonomySuggestion[]     @relation("TaxonomySuggestionReviewer")

  @@index([role])
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String
  recipientName String
  phone         String
  line1         String
  line2         String?
  city          String
  state         String
  pincode       String
  country       String   @default("India")
  isDefault     Boolean  @default(false)
  /// Set when the buyer allows the browser location prompt or picks an area
  /// at checkout. Null is normal (typed address, permission denied).
  lat           Float?
  lng           Float?
  area          String?
  instructions  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cartItems             CartItem[]
  orderItemsShippedTo   OrderItem[]
  shipments             OrderShipment[]    @relation("ShipmentAddress")
  hampersAsRecipient    Hamper[]           @relation("HamperRecipientAddress")
  mealSubscriptions     MealSubscription[]
  ordersAsGiftRecipient Order[]            @relation("OrderGiftRecipientAddress")
  laundryBookings       LaundryBooking[]

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Auth infrastructure (not a lib/types entity — server-only, backs the
// JWT access+refresh / phone-OTP / social flows described in the milestone
// brief).
// ---------------------------------------------------------------------------

/// One row per issued refresh token (rotating). A login/refresh mints a new
/// row; refreshing revokes the old one and stores `replacedByTokenId`, so a
/// reused/stolen refresh token is detectable (already-revoked lookup).
/// Only a hash is stored — never the raw token.
model RefreshToken {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  createdByIp       String?
  createdAt         DateTime  @default(now())

  @@index([userId])
}

/// Phone-OTP login/verify. `codeHash` (never the raw code) + short TTL +
/// `attempts` counter for basic brute-force resistance on top of the global
/// throttler. The OTP "sender" is a stub in M8.0 (logs to console) — see
/// `src/auth/otp.service.ts`.
/// M18 — one row per "forgot password" request.
///
/// Stored as a SHA-256 of the token, not the token itself: the emailed
/// value is a bearer credential for the account, so a leaked database dump
/// must not be a pile of working reset links. SHA-256 rather than argon2
/// for the same reason `RefreshToken` uses it — this is an exact-equality
/// index lookup, not a password verification, and the token is 32 random
/// bytes rather than something guessable.
///
/// Single-use (`consumedAt`) and short-lived (`expiresAt`). Rows are kept
/// after consumption rather than deleted so a support question about a
/// reset has an answer.
model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One issued verification code.
///
/// Was `PhoneOtp` until M25, when the same machinery started carrying
/// email codes too. The **table and column names are unchanged** — the
/// rename is `@@map`/`@map` only, so it is a pure rename in Prisma and
/// produces no SQL. Renaming mattered because the alternative was an
/// email sitting in a column called `phone`, which is the kind of thing
/// the next person copies.
model OtpChallenge {
  id String @id @default(cuid())

  /// Where the code was sent: an E.164 phone number **or** an email
  /// address. `AuthService` decides which by parsing it (see
  /// `identifier.util.ts`); this layer only ever treats it as an opaque
  /// key, which is why one column is right rather than two nullable ones.
  destination String @map("phone")

  codeHash   String
  /// `login` for sign-in, `verify` for confirming a contact somebody
  /// already signed up with. Kept apart so a code minted to prove you own
  /// an address cannot be replayed as a sign-in.
  purpose    String    @default("login")
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  /// Matches the query `OtpService.verify` actually runs — `findFirst`
  /// on `(destination, purpose, consumedAt: null)` ordered by `createdAt
  /// desc`. The old `@@index([phone])` alone made every verification scan
  /// and sort that phone's whole OTP history, which grows with the
  /// per-destination request cap (5 per window) and never shrinks: OTP
  /// rows are not deleted after use, only marked consumed. On the hot
  /// path of every phone sign-in, which is how an approved HomeKrafter
  /// gets in.
  @@index([destination, purpose, consumedAt, createdAt])
  @@map("PhoneOtp")
}

/// Stub social-login linkage — one row per (provider, providerAccountId) a
/// user has connected. M8.0's `/auth/social/:provider` endpoint is a stub
/// (trusts a client-submitted profile payload instead of verifying a real
/// OAuth token) — flagged in `auth.service.ts`; a real provider SDK
/// (Google/Apple) verification swaps in without a schema change.
model SocialAccount {
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          SocialProvider
  providerAccountId String
  createdAt         DateTime       @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

/// `targetType`/`targetId` stay a loosely-typed polymorphic pair (not
/// FK-enforced) per docs/DATA-MODEL.md's explicit note — `targetId` can
/// point at a Product, Vendor, or a (not-yet-modeled) service id.
/// `sellerReply` (an embedded object in lib/types) flattens to two nullable
/// columns, present together or not at all (app-level invariant).
model Review {
  id                   String           @id @default(cuid())
  targetType           ReviewTargetType
  targetId             String
  userId               String
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName             String
  rating               Int
  title                String?
  body                 String
  createdAt            DateTime         @default(now())
  helpfulCount         Int              @default(0)
  verifiedPurchase     Boolean          @default(false)
  sellerReplyBody      String?
  sellerReplyCreatedAt DateTime?
  flagged              Boolean          @default(false)
  hidden               Boolean          @default(false)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  category  NotificationCategory
  title     String
  body      String
  read      Boolean              @default(false)
  createdAt DateTime             @default(now())
  /// Polymorphic ref, not FK-enforced (order id / laundry booking id /
  /// wallet transaction id / support ticket id) — see docs/DATA-MODEL.md.
  refType   String?
  refId     String?

  @@index([userId, read])
}

model NotificationPreference {
  id       String               @id @default(cuid())
  userId   String
  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category NotificationCategory
  sms      Boolean              @default(false)
  whatsapp Boolean              @default(false)
  email    Boolean              @default(false)
  inapp    Boolean              @default(true)

  @@unique([userId, category])
}

// ---------------------------------------------------------------------------
// Referral & loyalty
// ---------------------------------------------------------------------------

model Referral {
  id             String         @id @default(cuid())
  referrerUserId String
  referrer       User           @relation("ReferralsSent", fields: [referrerUserId], references: [id], onDelete: Cascade)
  code           String
  refereeName    String?
  refereeUserId  String?
  referee        User?          @relation("ReferralsReceived", fields: [refereeUserId], references: [id])
  status         ReferralStatus @default(pending)
  rewardAmount   Decimal?       @db.Decimal(10, 2)
  createdAt      DateTime       @default(now())

  @@index([referrerUserId])
}

model LoyaltyAccount {
  id               String      @id @default(cuid())
  userId           String      @unique
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier             LoyaltyTier @default(bronze)
  points           Int         @default(0)
  lifetimePoints   Int         @default(0)
  pointsToNextTier Int?
}

// ---------------------------------------------------------------------------
// Support
// ---------------------------------------------------------------------------

model SupportTicket {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  channel   SupportChannel
  status    SupportTicketStatus @default(open)
  orderRef  String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  messages  SupportMessage[]

  @@index([userId])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender    SupportSender
  body      String
  createdAt DateTime      @default(now())

  @@index([ticketId])
}

// ---------------------------------------------------------------------------
// Corporate inquiry & seller applications (both standalone — may predate an
// account, per lib/types' own doc comments).
// ---------------------------------------------------------------------------

model CorporateInquiry {
  id                String                 @id @default(cuid())
  companyName       String
  contactName       String
  email             String
  phone             String
  occasion          String?
  estimatedQuantity Int
  budgetRange       String?
  message           String
  status            CorporateInquiryStatus @default(new)
  /// M20. Defaults to `corporate` — every row that existed before this
  /// column came through a form that only asked about client gifting.
  orderType         CorporateOrderType     @default(corporate)
  /// M20. Free-text admin notes. Not a message thread: nothing here is
  /// ever shown to the customer, so it is the one place an admin can
  /// write "called, they want it before the 14th" without publishing it.
  internalNotes     String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  quotes CorporateQuote[]

  @@index([status, createdAt])
}

/// M20. What is actually being offered, at what price, until when.
///
/// The status enum on `CorporateInquiry` already had `quoted` in it and
/// there was nothing being quoted — a dropdown is not a B2B motion.
model CorporateQuote {
  id         String               @id @default(cuid())
  inquiryId  String
  inquiry    CorporateInquiry     @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  status     CorporateQuoteStatus @default(draft)
  /// After this, `GET /corporate/quotes/:token` reports `expired` and
  /// accept refuses. Checked server-side on every read, never trusted
  /// from a client clock.
  validUntil DateTime
  notes      String?

  /// Money. `total` is stored rather than summed on read because it is
  /// what somebody agreed to pay: recomputing it later from lines that
  /// have since been edited would change a number after acceptance.
  ///
  /// `subtotal` alone is not a total, and nobody can accept a figure that
  /// is not the figure they will be invoiced — so tax and delivery are
  /// their own columns rather than a footnote.
  subtotal    Decimal @db.Decimal(12, 2)
  taxAmount   Decimal @default(0) @db.Decimal(12, 2)
  deliveryFee Decimal @default(0) @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  /// **Only the SHA-256 hash of the accept token is ever stored**, never
  /// the token — same rule as `PasswordResetToken`. A database leak must
  /// not hand somebody the ability to accept every outstanding quote.
  tokenHash String?   @unique
  sentAt    DateTime?
  /// Set when the token is rotated or the quote withdrawn. A revoked
  /// token is indistinguishable from a nonexistent one to a prober.
  revokedAt DateTime?

  /// Who accepted, typed by them. For a five-figure commitment reached
  /// through a forwardable link, a timestamp alone is not evidence.
  acceptedAt   DateTime?
  acceptedName String?
  declinedAt   DateTime?

  createdById String
  createdBy   User     @relation("CorporateQuoteCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines CorporateQuoteLine[]

  @@index([inquiryId])
  @@index([status])
}

model CorporateQuoteLine {
  id      String         @id @default(cuid())
  quoteId String
  quote   CorporateQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  /// Optional: half of corporate gifting is "custom hamper, 50 units, our
  /// branding", and forcing that into a catalogue reference loses the
  /// deal. `description` carries it instead.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  /// **Required, even on a custom line.** Every downstream path — seller
  /// order visibility, seller notifications, payouts — resolves a kitchen
  /// through the listing. A line naming no kitchen is work nobody can see
  /// and money nobody can be paid, which is the silent-failure class this
  /// whole milestone keeps closing.
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  lineTotal   Decimal @db.Decimal(12, 2)
  sortOrder   Int     @default(0)

  @@index([quoteId])
  @@index([vendorId])
  // M37 perf pass.
  @@index([productId])
}

/// The one way in. Everyone who wants to sell fills this in at `/sell`; an
/// admin approves it and that creates the `User` (if new), the `Vendor` and
/// the `Seller`. There is no self-serve HomeKrafter signup.
model SellerApplication {
  id               String                    @id @default(cuid())
  businessName     String
  contactName      String
  email            String
  phone            String
  category         SellerApplicationCategory
  /// What they intend to offer. Carried onto `Seller.specialties` on approval.
  specialties      SellerSpecialty[]
  city             String
  /// **Legacy since M36 — new applications carry `pincode` instead.**
  ///
  /// A tricity area id from `server/src/common/geo.ts#TRICITY_AREAS`, or
  /// the literal `"other"`. Nullable now because the `/sell` form stopped
  /// asking: it was a closed list of 21 curated areas, so every applicant
  /// outside the tricity answered `"other"`, and `"other"` could not be
  /// approved. Rows written before M36 keep their value and still approve
  /// exactly as they did.
  area             String?
  /// Where they are (M36) — six digits, resolved through
  /// `server/src/common/pincodes.ts`. This is what made supply national:
  /// any valid Indian pincode is approvable, so nobody lands on a
  /// waitlist that no screen can move them off.
  ///
  /// It supplies the **district and state**, which are reliable, and a
  /// **seed** coordinate, which is not — an admin confirms the map pin at
  /// approval. See `Vendor.lat`.
  pincode          String?
  /// Free text, required when `area` is `"other"`: the locality they typed.
  /// Captures expansion demand without promising delivery there. Retained
  /// for pre-M36 rows; a pincode application has no use for it.
  areaLabel        String?
  /// Where a rider will collect from — the applicant's **home address**
  /// (M36). Carried onto `VendorProfile.pickupAddress*` at approval.
  ///
  /// **Private, and the form says so out loud.** It is never in a public
  /// payload: `mapSellerApplication` is admin-only, `mapVendor` never
  /// reads the profile columns this becomes, and `vendor-privacy.spec.ts`
  /// fails the build if that changes. Asking a home cook for their home
  /// address and then publishing it is the failure this whole cluster of
  /// comments exists to prevent.
  addressLine1     String?
  addressLine2     String?
  landmark         String?
  /// A second number for the rider, when the account's phone is not the
  /// one at the door.
  pickupPhone      String?
  /// How far they're willing to deliver, in km. **Nullable on purpose**
  /// (M19): with a non-null default of 10, `approveApplication`'s
  /// `deliveryRadiusKm || defaultRadiusKm` always saw a truthy 10 and the
  /// platform default was unreachable. Null means "they didn't say", which
  /// is the only thing that lets the platform setting apply.
  deliveryRadiusKm Int?
  description      String
  /// Where their work already lives — an Instagram handle or a shop link
  /// (M32). Optional, and the single most useful thing on the form for
  /// deciding whether a stranger's kitchen is real: an admin can look.
  ///
  /// **Photos were the other option and were deliberately not built.**
  /// `POST /uploads` is authenticated by design, and `/sell` is public —
  /// opening an anonymous upload route to collect three sample images
  /// would be a new abuse surface on the one endpoint that writes files
  /// to disk. A link points at work they have already published.
  instagramUrl     String?
  websiteUrl       String?
  /// Their FSSAI licence number, asked only of applicants who say they
  /// make food (`makesFood`). Carried onto `VendorProfile.fssaiNumber` at
  /// approval, where it stays **unverified** — only
  /// `PATCH /admin/sellers/:id/verification` can set the badge, and
  /// nothing on this form may reach it (M16).
  fssaiNumber      String?
  /// How long they have been making this, in years. Nullable — "didn't
  /// say" is not "brand new", and an applicant of twenty years and one of
  /// zero must not both read as 0.
  yearsMaking      Int?
  /// Roughly how many orders a day they can take. Carried onto
  /// `VendorProfile.capacityPerDay`, which is the number a meal plan's
  /// `maxSubscribers` and future capacity limits read.
  capacityPerDay   Int?
  status           SellerApplicationStatus   @default(new)
  /// Set when an admin rejects or waitlists, shown back to the applicant.
  decisionNote     String?
  createdAt        DateTime                  @default(now())

  /// M37 — the admin queue's exact read: new applications first, by age.
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Wallet
// ---------------------------------------------------------------------------

model Wallet {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance              Decimal  @default(0) @db.Decimal(12, 2)
  pendingCashback      Decimal  @default(0) @db.Decimal(12, 2)
  lifetimeSaved        Decimal  @default(0) @db.Decimal(12, 2)
  payWithWalletDefault Boolean  @default(true)
  updatedAt            DateTime @updatedAt

  transactions   WalletTransaction[]
  autoTopupRule  AutoTopupRule?
  razorpayOrders RazorpayOrder[]
}

/// `balanceAfter` is the server-authoritative running total — per
/// docs/DATA-MODEL.md, only ever written inside the same DB transaction
/// that mutates `Wallet.balance` (M8.2 wallet-service concern; this
/// milestone only lays the table down).
model WalletTransaction {
  id           String                     @id @default(cuid())
  walletId     String
  wallet       Wallet                     @relation(fields: [walletId], references: [id], onDelete: Cascade)
  direction    WalletTransactionDirection
  category     WalletTransactionCategory
  amount       Decimal                    @db.Decimal(12, 2)
  balanceAfter Decimal                    @db.Decimal(12, 2)
  title        String
  refType      WalletTransactionRefType?
  refId        String?
  createdAt    DateTime                   @default(now())

  @@index([walletId, createdAt])
}

model AutoTopupRule {
  id               String           @id @default(cuid())
  walletId         String           @unique
  wallet           Wallet           @relation(fields: [walletId], references: [id], onDelete: Cascade)
  enabled          Boolean          @default(false)
  trigger          AutoTopupTrigger
  thresholdAmount  Decimal?         @db.Decimal(12, 2)
  topupAmount      Decimal          @db.Decimal(12, 2)
  paymentMethodRef String?
}

/// M8.2 — a client-supplied key (`Idempotency-Key` header, typically) that
/// scopes a money-mutating op to "run at most once". The op runs inside a
/// transaction that inserts its claim row here *before* doing the real
/// work and stamps the same row with the JSON result once done, all
/// atomically — see `src/common/idempotency/idempotency.service.ts` for
/// the full mechanics (relies on Postgres' own unique-index conflict
/// handling to serialize concurrent duplicate attempts, no polling).
model IdempotencyKey {
  id           String   @id @default(cuid())
  userId       String
  scope        String
  key          String
  responseBody Json
  createdAt    DateTime @default(now())

  @@unique([userId, scope, key])
}

/// M8.2 — dedup ledger for inbound Razorpay webhook deliveries. Razorpay
/// (like most webhook senders) may redeliver the same event on a timeout
/// or non-2xx response; a unique violation on insert here is exactly the
/// signal "already processed this one" — see `PaymentsService.handleWebhook`.
model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String   @default("razorpay")
  eventId     String
  paymentId   String?
  processedAt DateTime @default(now())

  @@unique([provider, eventId])
}

/// M8.2 — one row per Razorpay order we've opened (`POST
/// /payments/razorpay/order`), tracking what it's *for* so the webhook
/// handler knows what to credit/transition on `payment.captured` without
/// trusting anything in the webhook payload beyond the payment id itself.
/// `orderId` is set when `purpose: "order"`, `walletId` when `purpose:
/// "topup"` — same app-level XOR convention as `CartItem`'s
/// product-or-hamper polymorphic line.
model RazorpayOrder {
  id              String               @id @default(cuid())
  razorpayOrderId String               @unique
  purpose         RazorpayOrderPurpose
  amount          Decimal              @db.Decimal(12, 2)
  userId          String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId         String?
  order           Order?               @relation(fields: [orderId], references: [id])
  walletId        String?
  wallet          Wallet?              @relation(fields: [walletId], references: [id])
  status          RazorpayOrderStatus  @default(created)
  createdAt       DateTime             @default(now())

  @@index([userId])
  // M37 perf pass.
  @@index([orderId])
  @@index([walletId])
}

// ---------------------------------------------------------------------------
// Marketplace: vendors, catalog, cart/wishlist, hampers, orders
// ---------------------------------------------------------------------------

model Vendor {
  id                String     @id @default(cuid())
  slug              String     @unique
  name              String
  type              VendorType
  bio               String
  avatarPlaceholder String
  bannerPlaceholder String
  avatarSrc         String?
  bannerSrc         String?
  /// Human-readable address line shown on the storefront ("Sector 35, Chandigarh").
  location          String
  /// The coarsest location key we hold for this kitchen.
  ///
  /// A curated `TRICITY_AREAS` id where one applies — that is what a buyer
  /// picks in the manual area picker when they decline the browser
  /// location prompt — and the **pincode** for a HomeKrafter outside the
  /// curated areas (M36, when supply went national). Read for text search
  /// and display only; nothing filters on it, which is why one column can
  /// carry both without breaking anything. Distance filtering has always
  /// used `lat`/`lng`.
  area              String
  /// Where they said they are (M36). Six digits, resolvable through
  /// `server/src/common/pincodes.ts`. **Not** the source of `lat`/`lng` —
  /// see below.
  pincode           String?
  /// Kitchen coordinates. Distance to a buyer is computed with haversine
  /// (`server/src/common/geo.ts`); a listing is shown when that distance is
  /// within `deliveryRadiusKm`.
  ///
  /// **Confirmed by an admin at approval, never taken raw from a pincode.**
  /// The bundled pincode table's centroid is trustworthy for only 44% of
  /// India's pincodes — the median pincode's post offices are 12.4 km
  /// apart — and this column decides which buyers can see this kitchen at
  /// all. A 12 km error here hides a real storefront from its own
  /// neighbourhood. `seedCoordsForPincode` gives the admin a starting
  /// point to adjust; it is not an answer.
  lat               Float
  lng               Float
  /// When a person last confirmed `lat`/`lng` is really the kitchen —
  /// the HomeKrafter's own GPS pin (`PATCH /seller/profile/coords`,
  /// 2026-08-18) or an admin correction (`PATCH /admin/sellers/:id/coords`).
  /// NULL means the coordinates are still whatever approval seeded (a
  /// pincode centroid or curated area point) and nobody has vouched for
  /// them — which is what the profile completion meter nudges about.
  pinConfirmedAt    DateTime?
  /// How far this HomeKrafter is willing to deliver. They control it from
  /// their storefront settings.
  deliveryRadiusKm  Int        @default(10)
  rating            Decimal    @default(0) @db.Decimal(2, 1)
  reviewCount       Int        @default(0)
  followerCount     Int        @default(0)
  joinedAt          DateTime   @default(now())

  /// M46 — a discount the HomeKrafter sets on their own listings, as a
  /// whole percent off every product of theirs.
  ///
  /// **It is their money, not the platform's.** The percentage comes off
  /// the price a buyer pays, so it comes off the kitchen's own take: the
  /// commission split (`seller/payout-split.ts`) is computed on what was
  /// actually charged. The seller screen says so in those words before
  /// anything is saved, because a discount that quietly costs somebody
  /// more than they expected is worse than no discount at all.
  ///
  /// NULL or 0 means no discount. Capped at `MAX_VENDOR_DISCOUNT_PCT`
  /// (`catalog/vendor-discount.ts`) — a home cook is not in a position to
  /// discount 90% of their own income, and a runaway value here would
  /// reach every one of their listings at once.
  discountPct    Int?
  /// When the discount stops, exclusive. NULL means it runs until the
  /// HomeKrafter turns it off — which is a real case ("everything is 10%
  /// off, always"), so it is not treated as an unfinished date.
  ///
  /// **Nothing expires this row.** There is no scheduler; every read
  /// asks `activeDiscountPct(vendor, now)`, so a lapsed discount stops
  /// applying the moment the date passes rather than the next time some
  /// job happens to run.
  discountEndsAt DateTime?

  products            Product[]
  seller              Seller?
  mealPlans           MealPlan[]
  follows             VendorFollow[]
  profile             VendorProfile?
  photos              VendorPhoto[]
  blackouts           VendorBlackoutDate[]
  quoteLines          CorporateQuoteLine[]
  /// M50 — shelves and occasions this storefront has asked for.
  taxonomySuggestions TaxonomySuggestion[]
}

/// M16 (M2). A day this kitchen is not taking orders — a festival they
/// are cooking for their own family, travel, a sold-out batch.
///
/// Stored as a **list of specific dates**, not a recurring rule: the
/// weekly pattern already exists as `VendorProfile.workingDays`, and what
/// this covers is the exception to it. A recurrence here would collide
/// with that and make "am I open on the 14th" answerable two ways.
///
/// Deliberately separate from `Product.isAvailable` (the HomeKrafter's
/// per-item switch) and `moderationStatus` (the admin's) — this is about
/// *when*, and merging any of the three would make one switch silently
/// override another.
model VendorBlackoutDate {
  id       String   @id @default(cuid())
  vendorId String
  vendor   Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  /// Date only, stored at UTC midnight. A blackout is a whole day —
  /// nobody blocks out 14:00–16:00 on a Tuesday.
  date     DateTime @db.Date
  /// Shown to buyers on the picker ("Closed — Diwali"), so keep it short.
  reason   String?

  @@unique([vendorId, date])
  @@index([vendorId, date])
}

/// M16 (H5). Everything a buyer wants to know before trusting a stranger's
/// kitchen, kept **off** `Vendor` on purpose: `Vendor` is the catalogue
/// entity, read on every product card, every distance filter and every
/// listing query, and none of those need a shop's story or its return
/// policy. A 1:1 optional table means the profile is loaded only by the
/// storefront and the seller editor, and "has this HomeKrafter filled
/// anything in" is answerable by the row's existence.
///
/// **The verification flags are admin-only.** A HomeKrafter submits an
/// FSSAI number; an admin decides whether the badge appears. The badge is
/// the entire point of the panel, so the write path for it is
/// `PATCH /admin/sellers/:id/verification`, never `PATCH /seller/profile`
/// — see `SellerProfileService.updateOwn`, which strips them.
///
/// Nothing derived is stored here. Trust score, achievements and profile
/// completion are all computed from rows on read
/// (`VendorProfileService`), for the same reason M15's rating aggregates
/// are recomputed rather than incremented: a stored trust score is a
/// number that silently stops being true.
model VendorProfile {
  vendorId String @id
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  // --- Story: who is behind the kitchen ---------------------------------
  /// One line under the name. Not `bio` — `bio` is the catalogue blurb.
  tagline   String?
  /// Long-form. The "we started this in 2019 with my mother's recipe" text.
  story     String?
  /// Free-text dish/craft names this kitchen is known for. Display only —
  /// discovery still runs off `Seller.specialties` and `Category`.
  knownFor  String[]
  /// Languages the HomeKrafter can take an order in. Real friction in the
  /// tricity: a buyer who can only phone in Punjabi needs to know.
  languages String[]

  // --- Operations: what ordering from them is actually like -------------
  /// Typical time from order to ready, in minutes. Feeds the pre-order
  /// slot suggestion (M2) and sets the buyer's expectation on the listing.
  prepTimeMins     Int?
  /// Self-declared "I usually reply within". Shown as declared, not as
  /// measured — we do not track message latency yet, and claiming a
  /// measured number we do not measure would be a lie on a trust panel.
  responseTimeMins Int?
  /// How many orders a day this kitchen can take. A home cook's ceiling is
  /// real and low; surfacing it is what stops a festival rush from
  /// producing a hundred cancellations.
  capacityPerDay   Int?
  minOrderValue    Decimal? @db.Decimal(10, 2)
  /// Days of the week the kitchen works, 0 = Sunday. Empty = unspecified,
  /// which the UI reads as "no set days", not "closed".
  workingDays      Int[]
  /// "09:00" / "19:30", local time, stored as strings for the same reason
  /// `LaundrySlot` windows are: they are a label, not an instant.
  opensAt          String?
  closesAt         String?

  // --- Policies: what a dispute gets decided on -------------------------
  cancellationPolicy  String?
  returnPolicy        String?
  customOrderPolicy   String?
  acceptsCustomOrders Boolean @default(false)
  packagingNote       String?
  /// How the kitchen handles hygiene — gloves, sealed packing, FSSAI
  /// practices. The single most asked question about home food.
  hygieneNote         String?

  // --- Pickup address: PRIVATE, never public (M36) -----------------------
  //
  // Where a rider collects the order. This is a home cook's **home
  // address**, and the `/sell` form promises in as many words that it is
  // never shown to buyers. That promise is enforced in code, not just
  // written: `mapVendor` — the one mapper behind every public vendor
  // payload — does not read these, and `vendor-privacy.spec.ts` fails the
  // build if it ever does.
  //
  // Three rules if you touch this.
  //
  // **Never merge it into `Vendor.location`.** That field is the
  // storefront's public address line ("Sector 35, Chandigarh"); it is
  // deliberately coarse, and copying a house number into it publishes
  // exactly what this promises not to.
  //
  // **Never add it to `VendorProfileService`'s public projection.** The
  // buyer needs a verified fact, not an identifier — the same rule
  // `fssaiNumber` already follows.
  //
  // **It is the same exposure M25's EXIF strip exists to prevent.** A
  // phone photo of a home kitchen carried GPS and publishing it published
  // a home cook's address; this is that address, typed in directly.
  pickupAddressLine1 String?
  pickupAddressLine2 String?
  /// "Opposite the gurudwara" — India addresses by landmark, and a rider
  /// finds a house this way when the line above is not enough.
  pickupLandmark     String?
  /// Six digits. Kept alongside `Vendor.pincode` rather than derived from
  /// it: the storefront's pincode is where they are *listed*, this is
  /// where a rider actually goes, and for a shared kitchen or a second
  /// unit they are not the same.
  pickupPincode      String?
  /// Optional second number for the rider, when the account's phone is
  /// not the one at the door.
  pickupPhone        String?

  // --- Verification: admin writes only ----------------------------------
  /// As submitted by the HomeKrafter. Present + `fssaiVerified` false means
  /// "claimed, not checked" — the UI must never render that as a badge.
  fssaiNumber      String?
  fssaiExpiry      DateTime?
  fssaiVerified    Boolean   @default(false)
  identityVerified Boolean   @default(false)
  addressVerified  Boolean   @default(false)
  /// When an admin last touched any of the three flags above, and why.
  verifiedAt       DateTime?
  verificationNote String?

  // --- Social ------------------------------------------------------------
  instagramUrl String?
  facebookUrl  String?
  youtubeUrl   String?
  websiteUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum VendorPhotoKind {
  kitchen
  process
  team
  award
}

/// M16 (H5). Photos of the kitchen itself, separate from `Product.images`.
/// A list rather than columns on `VendorProfile` because the count is
/// open-ended and ordering matters — the same reason `ProductImage` is its
/// own table. Uploaded through `<PhotoUpload>` (M14), so `url` is stored,
/// never the storage key.
model VendorPhoto {
  id        String          @id @default(cuid())
  vendorId  String
  vendor    Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  kind      VendorPhotoKind @default(kitchen)
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())

  @@index([vendorId, sortOrder])
}

/// Not a lib/types entity yet — `Vendor.isFollowing` is a per-viewer
/// derived flag in the mock layer with nothing backing it; a real "follow"
/// feature needs a join table, so this is added now rather than bolted on
/// later. `isFollowing` for a given viewer = `exists(VendorFollow{userId,
/// vendorId})`.
model VendorFollow {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, vendorId])
  // M37 perf pass — `followerCount` recomputes count by `vendorId`.
  @@index([vendorId])
}

model Category {
  id               String      @id @default(cuid())
  slug             String      @unique
  name             String
  imagePlaceholder String
  imageSrc         String?
  productCount     Int         @default(0)
  /// M20. Which side of the catalogue this belongs to — the header splits
  /// "Homemade Food" from "Handcrafted Gifts", and a category has to say
  /// which one it is. Defaults to `food`: everything that existed before
  /// this column was food.
  group            ProductKind @default(food)
  /// M20. Display order on the home page's category tiles. Ties fall back
  /// to name, so an unset value is stable rather than random.
  sortOrder        Int         @default(0)

  products Product[]

  @@index([group, sortOrder])
}

model Occasion {
  id      String @id @default(cuid())
  slug    String @unique
  name    String
  initial String

  /// M16 (H8). The next date this occasion actually falls on, as an
  /// absolute date an admin sets — **not** a recurrence rule. Indian
  /// festivals move against the Gregorian calendar every year (Diwali is
  /// lunisolar), so a `MM-DD` field or a "repeats yearly" flag would be
  /// wrong for exactly the occasions that matter most here. `null` means
  /// evergreen: a birthday has no season, and the hub lists those
  /// separately rather than sorting them into a countdown they don't have.
  celebratedOn DateTime?
  /// One line for the hub card ("Lamps, sweets and a lot of relatives").
  tagline      String?
  imageSrc     String?

  products    ProductOccasion[]
  collections Collection[]
}

/// M50. What a HomeKrafter is asking to be added to the catalogue's shared
/// vocabulary — a shelf (`Category`) or an occasion.
enum TaxonomyKind {
  category
  occasion
}

enum TaxonomySuggestionStatus {
  pending
  approved
  rejected
}

/// A request to add a category or an occasion, from the person who found
/// the list too short (M50).
///
/// **Why this is a suggestion and not a row in the real table.** A
/// HomeKrafter could not previously say "there is no shelf for what I
/// make" anywhere in the product: the shelf picker's empty state read
/// "Ask us to add it" and there was nobody to ask. But the two tables it
/// wants to write are a *shared vocabulary the whole catalogue browses
/// by*, and one anybody can append to stops being one — "Diwali",
/// "diwali " and "Deepavali" as three hub pages splitting one festival's
/// traffic, with nothing in the product able to merge them. The same is
/// true of a shelf: "Pickles", "Pickle" and "Achaar" is three half-empty
/// category pages.
///
/// So the ask is recorded here, an admin reads it beside the others, and
/// **the admin mints the real row** — which is also where a duplicate is
/// spotted by somebody who can see the whole list. `Occasion` therefore
/// keeps its invariant exactly: nothing outside `src/admin` writes that
/// table, and `test/unit/occasion-admin-only.spec.ts` still passes.
///
/// A rejection carries a `decisionNote`, and it reaches the HomeKrafter
/// **verbatim** — the M22 rule. A refusal with no reason is the thing
/// that makes people stop asking.
model TaxonomySuggestion {
  id     String                   @id @default(cuid())
  kind   TaxonomyKind
  /// As typed, whitespace-collapsed. Never slugged here: the admin may
  /// rename it on approval, and the slug belongs to the real row.
  name   String
  /// Which half of the catalogue a suggested **category** belongs to,
  /// taken from the answer the form already has ("something to eat" /
  /// "something to keep"). Null for an occasion, which has no side.
  group  ProductKind?
  /// Optional: what they make, in their words. The one thing that lets an
  /// admin tell a genuinely missing shelf from a synonym of an existing
  /// one.
  note   String?
  status TaxonomySuggestionStatus @default(pending)

  suggestedById String
  suggestedBy   User    @relation("TaxonomySuggestionAuthor", fields: [suggestedById], references: [id])
  /// The storefront it was asked for, when there is one. Absent for an
  /// admin-side suggestion.
  vendorId      String?
  vendor        Vendor? @relation(fields: [vendorId], references: [id])

  reviewedById String?
  reviewedBy   User?     @relation("TaxonomySuggestionReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  /// The reason, sent to the HomeKrafter word for word on a rejection.
  decisionNote String?

  /// What approval actually created. Kept so the queue can link to the
  /// live row and so a second identical ask can be answered with it.
  resultCategoryId String?
  resultOccasionId String?

  createdAt DateTime @default(now())

  /// The queue is read newest-pending-first, and that is the only listing.
  @@index([status, createdAt])
  @@index([suggestedById])
}

model Collection {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String?
  occasionId  String?
  occasion    Occasion? @relation(fields: [occasionId], references: [id])

  /// M16 (H8). A `Collection` is a gift guide with its own page
  /// (`/guides/[slug]`), not just the curated ordering behind an occasion
  /// page — so it needs its own art and its own place in a running order.
  /// `featured` is what the hub and the home rail promote.
  imageSrc  String?
  featured  Boolean @default(false)
  sortOrder Int     @default(0)

  products CollectionProduct[]

  // M37 perf pass.
  @@index([occasionId])
}

/// `Collection.productIds` (an ordered id array in the mock) becomes a real
/// join table; `sortOrder` preserves the array's display order per
/// docs/DATA-MODEL.md's note ("array order is the collection's real display
/// order").
model CollectionProduct {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder    Int        @default(0)

  @@unique([collectionId, productId])
  // M37 perf pass — `productId` is not the leading column of the unique above.
  @@index([productId])
}

/// `dietary`/`tags` stay native Postgres enum arrays (small, fixed tag
/// sets — not full entities, so a join table doesn't pay for itself).
/// `occasionIds` (many-to-many with real query patterns — "products for
/// this occasion") gets a proper join table (`ProductOccasion`) instead.
model Product {
  id                  String                  @id @default(cuid())
  slug                String                  @unique
  vendorId            String
  vendor              Vendor                  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name                String
  categoryId          String
  category            Category                @relation(fields: [categoryId], references: [id])
  /// M20. Food or craft — see `ProductKind`. Defaults to `food` so every
  /// row that existed before this column keeps its meaning without a
  /// backfill.
  kind                ProductKind             @default(food)
  /// M20. Local delivery or posted nationally — see `ProductShippingScope`.
  /// Defaults to `local`, which is what every pre-M20 listing was.
  shippingScope       ProductShippingScope    @default(local)
  dietary             DietaryTag[]
  defaultWeightSku    String
  rating              Decimal                 @default(0) @db.Decimal(2, 1)
  reviewCount         Int                     @default(0)
  tags                ProductTag[]
  isPackaged          Boolean                 @default(true)
  cashbackPct         Decimal                 @default(0) @db.Decimal(4, 2)
  description         String
  ingredients         String?
  shelfLife           String?
  storageInstructions String?
  madeIn              String?
  /// M22: defaults to `pending`, so a new listing is reviewed before it is
  /// public. It used to default to `active` — a listing went live the
  /// instant it was saved and moderation was retrospective takedown.
  moderationStatus    ProductModerationStatus @default(pending)
  /// Why an admin refused, hid or flagged this listing, in their own
  /// words, shown verbatim to the HomeKrafter. Required by
  /// `ModerateProductDto` on every refusing action: a refusal with no
  /// reason gives the person who has to fix it nothing to act on, and
  /// before M22 no reason was even recordable.
  moderationNote      String?
  moderatedById       String?
  moderatedBy         User?                   @relation("ProductModerator", fields: [moderatedById], references: [id])
  moderatedAt         DateTime?
  /// When this listing last entered `pending`. The review queue orders on
  /// it rather than `createdAt`, so a resubmitted listing takes its turn
  /// at the back instead of holding its original place in the queue
  /// forever.
  submittedAt         DateTime?
  /// HomeKrafter-controlled "am I making this right now" switch, toggled
  /// from the portal's Availability panel. Distinct from `moderationStatus`,
  /// which is admin-controlled: an item can be perfectly allowed but simply
  /// not being cooked today. Unavailable items stay off the storefront and
  /// out of search.
  isAvailable         Boolean                 @default(true)
  featured            Boolean                 @default(false)
  /// M18 — "this listing is a ready-made gift hamper", set by the
  /// HomeKrafter who lists it.
  ///
  /// A hamper is a `Product`, not a new entity, and this flag is the whole
  /// of the difference. It already needed a vendor, photos, price tiers,
  /// availability, moderation, reviews, cart, checkout and search; a
  /// parallel model would have re-derived every one of those and then
  /// drifted from them. The flag is a *listing* attribute rather than a
  /// `Category`, because a hamper is still a sweets or pickles hamper —
  /// overloading the browse taxonomy would force a false choice between
  /// the two.
  ///
  /// Unrelated to the `Hamper` model below, which is the retired
  /// buyer-assembled gift box (M3) kept only so historical orders still
  /// resolve.
  isHamper            Boolean                 @default(false)
  /// M20 — a capability flag, the same idea `isHamper` established: one
  /// catalogue entity, and each section of the site is a *filter* over it
  /// rather than its own table with its own copy of pricing, availability,
  /// moderation, reviews and search.
  ///
  /// `isSnack` puts a listing on the WhatsApp snacks menu. It is the
  /// kitchen's own decision, and an admin overrides it through
  /// `moderationStatus` exactly as for any other listing.
  ///
  /// The alternative — a table per section — is what produced `Snack` as a
  /// separate model, and that table now needs its own availability,
  /// its own seller resolution and its own moderation, none of which it
  /// fully has. Don't add a third.
  ///
  /// There was briefly an `isSubscribable` beside this. It was dropped:
  /// `MealPlan.productId` already says a listing is sold on subscription
  /// and says *which plan*, so the flag was a second, weaker source of
  /// truth for one fact — and nothing ever read it.
  isSnack             Boolean                 @default(false)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  images        ProductImage[]
  weightOptions WeightOption[]
  occasions     ProductOccasion[]
  collections   CollectionProduct[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]
  hamperItems   HamperItem[]
  mealPlans     MealPlan[]
  quoteLines    CorporateQuoteLine[]

  @@index([vendorId])
  @@index([categoryId])
  @@index([isHamper])
  /// The M20 section filter. Queried with `moderationStatus` and
  /// `isAvailable` alongside it, so the index earns its keep on the snacks
  /// menu rather than only on an admin screen.
  @@index([isSnack])
  /// M20. `/gifts` filters on `kind`, and `shippingScope` decides whether a
  /// listing is subject to the delivery-radius gate at all.
  @@index([kind])
  /// The M22 review queue: pending first, oldest submission first.
  @@index([moderationStatus, submittedAt])
  /// The default browse, served entirely from an index.
  ///
  /// `GET /products` with no search, price range or coordinates is
  /// `WHERE moderationStatus IN (...) AND isAvailable ORDER BY rating
  /// DESC, reviewCount DESC, id LIMIT 20` — the first request every
  /// visitor makes. Without this Postgres sequentially scanned the whole
  /// catalogue and top-N sorted it to return twenty rows: 2,016 rows read
  /// per request, which held at 40 ms alone and collapsed to a p95 of
  /// 2.06 s under a k6 ramp to 1000 VUs.
  ///
  /// The sort directions are part of the index, not decoration — an index
  /// ascending on `rating` cannot serve a descending scan without a sort
  /// step, which is the cost being removed.
  @@index([moderationStatus, isAvailable, rating(sort: Desc), reviewCount(sort: Desc), id])
}

model ProductOccasion {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  occasionId String
  occasion   Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)

  @@unique([productId, occasionId])
  // M37 perf pass — `occasionId` is not the leading column of the unique above.
  @@index([occasionId])
}

model ProductImage {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  placeholder String
  src         String?
  ratio       String
  sortOrder   Int     @default(0)

  @@index([productId])
}

model WeightOption {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String  @unique
  label     String
  price     Decimal @db.Decimal(10, 2)
  mrp       Decimal @db.Decimal(10, 2)
  stock     Int     @default(0)

  @@index([productId])
}

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  items CartItem[]
}

/// Polymorphic line per docs/DATA-MODEL.md: either a catalog product
/// (`productId`+`sku`) or an assembled hamper (`hamperId`) — never both.
/// Modeled as two nullable FKs + an app-level XOR (enforced in the M8.1
/// cart service; a DB CHECK constraint is a reasonable follow-up once
/// there's real write traffic to protect).
model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  sku       String?
  hamperId  String?
  hamper    Hamper?  @relation(fields: [hamperId], references: [id])
  quantity  Int      @default(1)
  giftWrap  Boolean  @default(false)
  addressId String?
  address   Address? @relation(fields: [addressId], references: [id])

  @@index([cartId])
  // M37 perf pass — Postgres does not index FK columns automatically, so
  // every delete/update on the referenced row was a sequential scan here.
  @@index([productId])
  @@index([hamperId])
  @@index([addressId])
}

model Wishlist {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  addedAt    DateTime @default(now())

  @@unique([wishlistId, productId])
  // M37 perf pass — `productId` is not the leading column of the unique above.
  @@index([productId])
}

model HamperBox {
  id         String  @id @default(cuid())
  name       String
  maxItems   Int
  price      Decimal @db.Decimal(10, 2)
  itemsLabel String

  hampers Hamper[]
}

model Hamper {
  id                 String         @id @default(cuid())
  userId             String
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  boxId              String
  box                HamperBox      @relation(fields: [boxId], references: [id])
  giftNote           String?
  wrap               GiftWrapStyle?
  ribbon             RibbonColor?
  nameCard           String?
  recipientAddressId String?
  recipientAddress   Address?       @relation("HamperRecipientAddress", fields: [recipientAddressId], references: [id])
  hidePrice          Boolean        @default(false)
  createdAt          DateTime       @default(now())

  items      HamperItem[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([userId])
  // M37 perf pass.
  @@index([boxId])
}

model HamperItem {
  id        String  @id @default(cuid())
  hamperId  String
  hamper    Hamper  @relation(fields: [hamperId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)

  // M37 perf pass — FK columns Postgres does not index on its own.
  @@index([hamperId])
  @@index([productId])
}

/// `OrderGift` (an embedded object in lib/types) flattens onto Order with a
/// `gift`-prefixed column set — present together or not at all
/// (`giftIsGift: false` is the "no gift" state, matching the mock's
/// `gift?: OrderGift` optionality). `shippingAddressIds` stays a
/// denormalized `String[]` convenience list per docs/DATA-MODEL.md;
/// `OrderShipment` (below) is the real source of truth for per-address
/// delivery dates.
model Order {
  id                     String        @id @default(cuid())
  orderNumber            String        @unique
  userId                 String
  user                   User          @relation(fields: [userId], references: [id])
  status                 OrderStatus   @default(placed)
  shippingAddressIds     String[]
  giftIsGift             Boolean       @default(false)
  giftRecipientName      String?
  giftRecipientAddressId String?
  giftRecipientAddress   Address?      @relation("OrderGiftRecipientAddress", fields: [giftRecipientAddressId], references: [id])
  giftHidePrice          Boolean       @default(false)
  giftMessage            String?
  placedAt               DateTime      @default(now())
  subtotal               Decimal       @db.Decimal(12, 2)
  shippingFee            Decimal       @default(0) @db.Decimal(12, 2)
  total                  Decimal       @db.Decimal(12, 2)
  walletApplied          Decimal       @default(0) @db.Decimal(12, 2)
  cashbackEarned         Decimal       @default(0) @db.Decimal(12, 2)
  refundStatus           RefundStatus  @default(none)
  /// Why the buyer asked for their money back, in their own words, and
  /// when. Set by `POST /orders/:id/cancel` and `POST /orders/:id/return`
  /// (M15) — before that, `RefundStatus.requested` existed in the enum
  /// with no path in the product that could reach it, so every refund was
  /// something an admin started with no record of what the buyer said.
  refundReason           String?
  refundRequestedAt      DateTime?
  /// When the HomeKrafter marked it delivered. The return window counts
  /// from here, not from `placedAt` — those can be a week apart on a
  /// made-to-order item, and counting from the wrong one either closes
  /// the window before the food arrives or leaves it open far too long.
  /// Null on rows that reached `delivered` before M15 added this.
  deliveredAt            DateTime?
  /// Set when the order is cancelled, by the buyer or an admin. Distinct
  /// from `refundRequestedAt`: a `pending-payment` order can be cancelled
  /// with no money involved at all.
  cancelledAt            DateTime?
  paymentMethod          PaymentMethod

  items          OrderItem[]
  shipments      OrderShipment[]
  razorpayOrders RazorpayOrder[]

  /// `[userId]` alone was the only index here, and no query uses it on its
  /// own: every buyer-facing read is `where userId orderBy placedAt desc`
  /// (`OrdersService.list`, `reorder`), so Postgres matched the index then
  /// sorted the result by hand. The composite serves the same lookups and
  /// hands back the ordering for free.
  @@index([userId, placedAt])
  /// Admin and seller order lists page a whole-table `orderBy placedAt
  /// desc`; without this, every one of them sorts the entire Order table.
  @@index([placedAt])
  /// `VendorProfileService.stats` counts delivered/cancelled per vendor,
  /// and the admin dashboard buckets by status.
  @@index([status])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  sku       String?
  hamperId  String?
  hamper    Hamper?  @relation(fields: [hamperId], references: [id])
  name      String
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)
  addressId String
  address   Address  @relation(fields: [addressId], references: [id])
  giftWrap  Boolean  @default(false)

  @@index([orderId])
  /// The hottest missing index in the schema. A HomeKrafter's orders are
  /// "orders containing one of my products" — `items: { some: { productId:
  /// { in: [...] } } }` — which is how `SellerOrdersService.list`,
  /// `assertOwned`, `SellerAnalyticsService` and `VendorProfileService.stats`
  /// all scope. With no index on `productId` every one of those scanned
  /// OrderItem end to end, so the seller portal got slower for each kitchen
  /// with every order anyone else placed.
  @@index([productId])
  // M37 perf pass — FK columns Postgres does not index on its own.
  @@index([addressId])
  @@index([hamperId])
}

model OrderShipment {
  id           String    @id @default(cuid())
  orderId      String
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  addressId    String
  address      Address   @relation("ShipmentAddress", fields: [addressId], references: [id])
  deliveryDate DateTime?

  @@unique([orderId, addressId])
}

// ---------------------------------------------------------------------------
// Laundry, Cleaning & Ironing
// ---------------------------------------------------------------------------

/// Availability lookup tables — not booking state, just what the picker UI
/// offers (see lib/types/laundry.ts's own "availability data, not booking
/// state" framing).
model LaundryDay {
  id      String   @id @default(cuid())
  day     String
  date    String
  isoDate DateTime
}

model LaundrySlot {
  id    String @id @default(cuid())
  label String

  pickupBookings   LaundryBooking[]      @relation("PickupSlot")
  deliveryBookings LaundryBooking[]      @relation("DeliverySlot")
  subscriptions    LaundrySubscription[]
}

model LaundryService {
  id              String              @id @default(cuid())
  slug            String              @unique
  name            String
  description     String
  pricingModel    LaundryPricingModel
  price           Decimal             @db.Decimal(10, 2)
  unitLabel       String
  priceIsFrom     Boolean             @default(false)
  priceLabel      String
  iconPlaceholder String?

  lines         LaundryBookingLine[]
  subscriptions LaundrySubscription[]
}

/// `pickupSlot`/`deliverySlot` (embedded `{date, slotId}` objects in
/// lib/types) flatten to a date column + a `LaundrySlot` FK each, named by
/// relation (`PickupSlot`/`DeliverySlot`) since both point at the same
/// model. `partnerId` (M10b) scopes a booking to a laundry-type `Seller`.
model LaundryBooking {
  id                  String               @id @default(cuid())
  bookingNumber       String               @unique
  userId              String
  user                User                 @relation(fields: [userId], references: [id])
  pickupDate          DateTime
  pickupSlotId        String
  pickupSlot          LaundrySlot          @relation("PickupSlot", fields: [pickupSlotId], references: [id])
  deliveryDate        DateTime
  deliverySlotId      String
  deliverySlot        LaundrySlot          @relation("DeliverySlot", fields: [deliverySlotId], references: [id])
  addressId           String
  address             Address              @relation(fields: [addressId], references: [id])
  photos              String[]
  specialInstructions String?
  subscriptionId      String?
  subscription        LaundrySubscription? @relation(fields: [subscriptionId], references: [id])
  paymentMethod       PaymentMethod
  status              LaundryBookingStatus @default(scheduled)
  estimatedTotal      Decimal              @db.Decimal(12, 2)
  walletCashback      Decimal?             @db.Decimal(12, 2)
  createdAt           DateTime             @default(now())
  partnerId           String?
  partner             Seller?              @relation(fields: [partnerId], references: [id])

  lines LaundryBookingLine[]

  @@index([userId])
  @@index([partnerId])
  // M37 perf pass.
  @@index([addressId])
  @@index([subscriptionId])
}

model LaundryBookingLine {
  id                String         @id @default(cuid())
  bookingId         String
  booking           LaundryBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceId         String
  service           LaundryService @relation(fields: [serviceId], references: [id])
  estimatedWeightKg Decimal?       @db.Decimal(6, 2)
  itemCount         Int?
  estimatedHours    Decimal?       @db.Decimal(6, 2)
  estimatedPrice    Decimal        @db.Decimal(10, 2)

  // M37 perf pass — FK columns Postgres does not index on its own.
  @@index([bookingId])
  @@index([serviceId])
}

model LaundrySubscription {
  id         String                  @id @default(cuid())
  userId     String
  user       User                    @relation(fields: [userId], references: [id])
  serviceId  String
  service    LaundryService          @relation(fields: [serviceId], references: [id])
  plan       LaundrySubscriptionPlan
  slotDay    String
  slotId     String
  slot       LaundrySlot             @relation(fields: [slotId], references: [id])
  active     Boolean                 @default(true)
  nextPickup DateTime

  bookings LaundryBooking[]

  @@index([userId])
  // M37 perf pass.
  @@index([serviceId])
  @@index([slotId])
}

// ---------------------------------------------------------------------------
// Snacks & food (full meals are promo-only — MealPromo is static content,
// no menu/order entities per lib/channel.ts)
// ---------------------------------------------------------------------------

model Snack {
  id               String        @id @default(cuid())
  slug             String        @unique
  name             String
  description      String
  price            Decimal       @db.Decimal(10, 2)
  category         SnackCategory
  diet             DietType
  imagePlaceholder String
  imageSrc         String?
  available        Boolean       @default(true)
  sellerId         String?
  seller           Seller?       @relation(fields: [sellerId], references: [id])

  /// M22. This table had **no moderation at all** — the one catalogue on
  /// the platform an admin could not touch. `SellerMenuService` lets a
  /// HomeKrafter create rows here directly, so leaving it ungated would
  /// have left an open door beside a locked one.
  moderationStatus ProductModerationStatus @default(pending)
  moderationNote   String?
  moderatedById    String?
  moderatedBy      User?                   @relation("SnackModerator", fields: [moderatedById], references: [id])
  moderatedAt      DateTime?
  submittedAt      DateTime?

  snackListItems  SnackListItem[]
  snackOrderItems SnackOrderItem[]

  @@index([sellerId])
  @@index([moderationStatus, submittedAt])
}

/// The customer's in-progress selection that becomes a WhatsApp payload —
/// never becomes an `Order` (Snacks has no on-site checkout, see
/// lib/channel.ts).
model SnackList {
  id              String          @id @default(cuid())
  userId          String?
  user            User?           @relation(fields: [userId], references: [id])
  estimateTotal   Decimal         @db.Decimal(10, 2)
  whatsappPayload String
  status          SnackListStatus @default(draft)
  createdAt       DateTime        @default(now())

  items SnackListItem[]

  @@index([userId])
}

model SnackListItem {
  id          String    @id @default(cuid())
  snackListId String
  snackList   SnackList @relation(fields: [snackListId], references: [id], onDelete: Cascade)
  snackId     String
  snack       Snack     @relation(fields: [snackId], references: [id])
  name        String
  quantity    Int
  price       Decimal   @db.Decimal(10, 2)

  // M37 perf pass — FK columns Postgres does not index on its own.
  @@index([snackListId])
  @@index([snackId])
}

/// M10b seller-side stand-in for a real inbound WhatsApp order — see
/// lib/types/food.ts's doc comment. M9's WhatsApp Cloud API ingestion is
/// expected to create these rows from real inbound messages without a
/// shape change.
model SnackOrder {
  id            String            @id @default(cuid())
  sellerId      String
  seller        Seller            @relation(fields: [sellerId], references: [id])
  customerName  String
  customerPhone String
  total         Decimal           @db.Decimal(10, 2)
  channel       SnackOrderChannel @default(whatsapp)
  status        SnackOrderStatus  @default(received)
  createdAt     DateTime          @default(now())

  items SnackOrderItem[]

  @@index([sellerId])
}

model SnackOrderItem {
  id           String     @id @default(cuid())
  snackOrderId String
  snackOrder   SnackOrder @relation(fields: [snackOrderId], references: [id], onDelete: Cascade)
  snackId      String
  snack        Snack      @relation(fields: [snackId], references: [id])
  name         String
  quantity     Int
  price        Decimal    @db.Decimal(10, 2)

  // M37 perf pass — FK columns Postgres does not index on its own.
  @@index([snackOrderId])
  @@index([snackId])
}

model MealPromo {
  id                String  @id @default(cuid())
  title             String
  description       String
  imagePlaceholder  String
  imageSrc          String?
  appStoreUrl       String
  playStoreUrl      String
  qrCodePlaceholder String
}

// ---------------------------------------------------------------------------
// Seller portal (M10) — Seller/Payout live here now (schema only); real
// seller-scoped endpoints are M8.3.
// ---------------------------------------------------------------------------

/// A HomeKrafter — the single supply-side role. There is no longer a
/// maker/laundry/snack split: one account type, one portal, every module
/// available to everyone. What a HomeKrafter actually does is described by
/// `specialties`, which is never consulted for authorization.
model Seller {
  id          String            @id @default(cuid())
  userId      String            @unique
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// What this kitchen/business offers. Discovery only — see `SellerSpecialty`.
  specialties SellerSpecialty[]
  /// Every HomeKrafter has a storefront now (it's how buyers find them and
  /// where their items hang), so this is required rather than maker-only.
  vendorId    String            @unique
  vendor      Vendor            @relation(fields: [vendorId], references: [id])
  displayName String
  status      SellerStatus      @default(pending)
  createdAt   DateTime          @default(now())
  rating      Decimal?          @db.Decimal(2, 1)
  reviewCount Int?

  payouts         Payout[]
  laundryBookings LaundryBooking[]
  snacks          Snack[]
  snackOrders     SnackOrder[]
  mealPlans       MealPlan[]

  @@index([status])
}

/// M16 (M5). Platform-wide settings an admin can change **without a
/// redeploy**. Before this, the commission rate existed nowhere, the
/// default delivery radius was a constant, and feature flags lived in
/// `client/lib/features.ts` — a build-time constant, so holding or
/// releasing a feature meant shipping a build.
///
/// A single-row table would have been simpler; a key/value one is used
/// because each setting is read by a different part of the system and a
/// wide row would mean every reader pulling every column. Values are
/// stored as text and parsed by `AdminSettingsService`, which owns the
/// schema — a `Json` column would move the same parsing problem without
/// making it typed.
///
/// **Nothing is stored here that nothing reads.** A settings screen full
/// of decorative knobs is worse than no settings screen: it implies
/// changes take effect.
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  /// Who last changed it. Every write is also an `AdminAuditLog` row —
  /// this is the cheap "when was this last touched" read.
  updatedBy String?
}

model Payout {
  id               String       @id @default(cuid())
  sellerId         String
  seller           Seller       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  /// The payable figure — net of commission when `commissionEnabled` was
  /// on at request time, gross otherwise. The three columns below say
  /// which, so every row explains its own arithmetic (M37).
  amount           Decimal      @db.Decimal(12, 2)
  /// Delivered earnings before any deduction. Null on pre-M37 rows,
  /// where `amount` was always gross.
  grossAmount      Decimal?     @db.Decimal(12, 2)
  /// What was actually deducted — 0 when the flag was off, so a row from
  /// a disabled era never looks like a 0% business decision was applied.
  commissionAmount Decimal?     @db.Decimal(12, 2)
  /// The rate *applied* (0 when disabled), not the configured rate.
  commissionPct    Decimal?     @db.Decimal(5, 2)
  periodStart      DateTime
  periodEnd        DateTime
  status           PayoutStatus @default(pending)
  paidAt           DateTime?
  /// The bank/UPI reference the money actually moved under (a UTR, a
  /// transaction id). Recorded because settlement happens **outside this
  /// system** — there is no payout-provider integration — so this string
  /// is the only link between "we marked it paid" and a real transfer,
  /// and it is what a HomeKrafter quotes when they say it never arrived.
  reference        String?
  /// Why it was rejected, or any note attached when settling. Shown to
  /// the HomeKrafter: a payout refused with no explanation is worse than
  /// one that never happened.
  note             String?
  /// Which admin settled or refused it, and when. Also written to
  /// `AdminAuditLog`; kept on the row too so the payout itself can say
  /// who touched it without a join across a loosely-typed log table.
  decidedById      String?
  decidedBy        User?        @relation("PayoutDecidedBy", fields: [decidedById], references: [id])
  decidedAt        DateTime?

  @@index([sellerId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Admin (M8.3c) — not a `lib/types` entity (no frontend mock equivalent);
// added fresh for the real backend per the M8.3c brief's "every admin
// mutation writes an audit row" requirement. `actorId` is always the
// acting admin's own `User.id` (never client-supplied — resolved from
// `@CurrentUser()` the same way every other actor id in this schema is).
// `targetType`/`targetId` are a loose (not FK-enforced) pointer at
// whatever row the action touched (`User`, `Seller`, `SellerApplication`,
// `Product`, `Review`, `Order`, `LaundryBooking`, `Wallet`, `Collection`,
// ...) — deliberately not a real relation, since one log table spans many
// unrelated target tables and a dangling reference (e.g. after a rare
// hard-delete) should never block writing the log itself. `metadata` is
// a free-form JSON blob for action-specific detail (e.g. `{ amount,
// reason }` for a wallet adjustment) kept out of `action`/`targetId` so
// `GET /admin/audit` can render a readable one-line summary per row.
// ---------------------------------------------------------------------------

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Meal subscriptions (M19)
//
// The recurring product the platform did not have. Two things about the
// shape are load-bearing and easy to undo:
//
// 1. **A cycle is PREPAID.** There is no payment mandate — `creditTopupTx`
//    is reachable only from the verified Razorpay webhook, and the
//    auto-top-up path that pretended otherwise is exactly the bug M19
//    opened with. So a buyer pays for N meals up front out of wallet
//    balance, in one debit, and the subscription spends that down. Nothing
//    charges anybody in the background. When UPI AutoPay lands, `amountPaid`
//    plus `mealsRemaining` is the seam to convert against.
//
// 2. **Every meal is a row.** `MealDelivery` exists so that skip, pause and
//    a kitchen's blackout day are all recorded facts rather than arithmetic
//    on a counter. A counter would make "why do I have 11 meals left when I
//    paid for 14" unanswerable, which on a daily-food product is the
//    question that gets asked.
// ---------------------------------------------------------------------------

/// What a kitchen offers on a recurring basis. Distinct from `Product` and
/// `Snack`: those are bought once, this is subscribed to, and the fields
/// that matter here (how many subscribers a home cook can carry, what a
/// week's rotation looks like) have no meaning on a one-off listing.
model MealPlan {
  id       String @id @default(cuid())
  slug     String @unique
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  /// Required, unlike `Snack.sellerId`. A subscription commits a kitchen to
  /// cooking on a schedule, so a plan whose fulfilment owner is unknown
  /// cannot be honoured — and a nullable column here would let one be
  /// created and only fail on the first delivery.
  sellerId String
  seller   Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  name        String
  description String

  /// **Optional as of M20.** A plan used to have to be breakfast, lunch or
  /// dinner, which made "monthly pickle box" or "weekly bread" impossible
  /// to express without a migration for every new idea.
  ///
  /// When set, it still picks the sensible default delivery window for that
  /// meal (nobody wants dinner at 15:00). When `null`, the plan is some
  /// other cadence and its windows come from the kitchen's own hours —
  /// see `bracketsFor`.
  mealType  MealType?
  /// What the kitchen calls this when it is not one of the three meals:
  /// "Monthly pickle box", "Weekly sourdough". Free text on purpose — the
  /// whole point is that a HomeKrafter does not need us to ship an enum
  /// value before they can sell something.
  slotLabel String?

  /// A plan can be backed by a listing the kitchen already has, rather than
  /// re-typing its name, description and photo. Optional because a tiffin
  /// service is a real plan with no single product behind it.
  ///
  /// `onDelete: SetNull` — deleting a listing must not silently delete the
  /// subscriptions people have paid for.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  diet DietType

  /// Per meal, not per cycle. The cycle price is this times the meal count,
  /// computed at subscribe time and snapshotted onto the subscription.
  pricePerMeal Decimal @db.Decimal(10, 2)

  /// "2 rotis, dal, sabzi, rice, salad". The single most asked question
  /// about a tiffin, and the reason a photo alone does not sell one.
  servingSize String?
  /// A week's rotation as free text, one line per day. Display only — a
  /// structured menu would need a per-date entity nobody has asked for, and
  /// home kitchens cook to what the market had.
  weeklyMenu  String[]

  imagePlaceholder String
  imageSrc         String?

  /// The kitchen's own switch, same split as `Product.isAvailable` vs
  /// `moderationStatus`: this is "am I taking subscribers", that is the
  /// admin's. A buyer needs both to pass. Merging them would let a
  /// moderator's action be silently undone by a cook toggling availability.
  isActive         Boolean                 @default(true)
  /// M22: same review gate as `Product`. Without it a kitchen refused a
  /// listing could publish the identical thing as a subscription plan,
  /// which would make the gate theatre.
  moderationStatus ProductModerationStatus @default(pending)
  moderationNote   String?
  moderatedById    String?
  moderatedBy      User?                   @relation("MealPlanModerator", fields: [moderatedById], references: [id])
  moderatedAt      DateTime?
  submittedAt      DateTime?

  /// The ceiling a home cook can actually cook to. `VendorProfile.capacityPerDay`
  /// has existed since M16 and is enforced nowhere; this one is checked on
  /// every subscribe. Null means unlimited, which is a deliberate choice a
  /// kitchen makes rather than a default they never saw.
  maxSubscribers Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions MealSubscription[]
  dayMenus      MealPlanDayMenu[]

  @@index([vendorId])
  @@index([sellerId])
  @@index([mealType, isActive])
  // M37 perf pass.
  @@index([productId])
}

/// One date's actual menu for one plan (M37).
///
/// `weeklyMenu` stays the undated rotation a browsing buyer reads; a row
/// here overrides it for a specific date, which is what lets a subscriber
/// answer "what arrives tomorrow" and lets the kitchen change one day
/// without re-marketing the plan. Lock state ("menus close at 20:00 the
/// evening before") is computed on read from `PlatformSettings.menuLockTime`
/// via `meals/menu-lock.ts` — never stored, so nothing needs a scheduler.
model MealPlanDayMenu {
  id     String   @id @default(cuid())
  planId String
  plan   MealPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  /// The delivery date this menu is for — UTC midnight as a calendar date,
  /// same convention as `MealDelivery.scheduledFor`.
  date   DateTime @db.Date
  /// One dish/line per entry, the shape `weeklyMenu` already uses.
  lines  String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, date])
  @@index([date])
}

/// One buyer's prepaid run of meals from one plan.
model MealSubscription {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId String
  plan   MealPlan @relation(fields: [planId], references: [id])

  /// Required. A meal has to go somewhere, and the review of the held plan
  /// found the original spec never set an address at all — the same defect
  /// that makes `OrderItem.addressId` required.
  addressId String
  address   Address @relation(fields: [addressId], references: [id])

  /// Start of the 30-minute window, "HH:MM" local, e.g. "12:30" meaning
  /// 12:30–13:00. A string for the same reason `LaundrySlot` windows are:
  /// it is a label the kitchen and the buyer agree on, not an instant, and
  /// storing it as a timestamp would silently move it across a DST-free
  /// timezone change nobody asked for.
  bracketStart String

  /// 0 = Sunday. Which days of the week this subscription runs.
  daysOfWeek Int[]

  status MealSubscriptionStatus @default(active)

  /// **Snapshot at subscribe time**, never re-read from the plan. Reading
  /// `MealPlan.pricePerMeal` fresh each cycle would protect the kitchen and
  /// silently change what the buyer pays — for a daily-food product that is
  /// the worst possible surprise. A price rise applies at renewal, where
  /// the buyer sees it before agreeing.
  pricePerMeal Decimal @db.Decimal(10, 2)
  /// What was actually debited from the wallet for this cycle.
  amountPaid   Decimal @db.Decimal(10, 2)

  mealsTotal     Int
  /// Decremented only on `delivered`. A skipped or unavailable meal stays
  /// owed, which is what makes the count answerable.
  mealsRemaining Int

  startDate DateTime @db.Date
  /// Moves outward every time a meal is skipped or the kitchen is closed —
  /// the buyer paid for a number of meals, not a number of days.
  endDate   DateTime @db.Date

  pausedAt    DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  deliveries MealDelivery[]

  @@index([userId, status])
  @@index([planId, status])
  // M37 perf pass.
  @@index([addressId])
}

/// One scheduled meal. The kitchen's work queue and the buyer's receipt.
model MealDelivery {
  id             String           @id @default(cuid())
  subscriptionId String
  subscription   MealSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  /// Date only, UTC midnight — the window lives in `bracketStart`.
  scheduledFor DateTime           @db.Date
  bracketStart String
  status       MealDeliveryStatus @default(scheduled)

  /// Why it isn't happening. A blackout's reason is copied here at the time
  /// so the buyer's history still explains itself after the kitchen clears
  /// its calendar.
  reason String?

  skippedAt   DateTime?
  deliveredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One meal per subscription per day. The uniqueness is what makes the
  /// scheduler safe to re-run.
  @@unique([subscriptionId, scheduledFor])
  @@index([scheduledFor, status])
}
