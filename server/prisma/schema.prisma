// Homekrafted — Prisma schema (M8.0)
//
// Mirrors `client/lib/types/*.ts` field-for-field — that TypeScript module
// is the schema contract (see root CLAUDE.md + docs/DATA-MODEL.md). Modeling
// notes/deviations from the literal TS shape are called out inline; the
// full rationale lives in docs/DATA-MODEL.md's "M8 Prisma mapping" section.
//
// Scope: M8.0 authors every domain model so later milestones (M8.1
// commerce, M8.2 wallet/Razorpay, M8.3 services/roles) only need to add
// endpoints, not tables. Only Auth + Users (+ Address) get real service
// logic in this milestone.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums — one per TS union in lib/types. `@map(...)` is used wherever the
// TS literal isn't a valid Prisma enum identifier (hyphens), so the DB value
// still round-trips to the exact string the frontend contract expects.
// ---------------------------------------------------------------------------

enum UserRole {
  consumer
  seller
  admin
}

enum AuthProvider {
  phone
  email
  google
  apple
}

/// Real auth providers we can actually issue a session for today (M8.0).
/// `AuthProvider` (above) stays the full lib/types union (incl. "apple",
/// not yet wired) — this is the narrower stub-provider set the social
/// login endpoint accepts.
enum SocialProvider {
  google
  apple
}

enum ReviewTargetType {
  product
  vendor
  service
}

enum NotificationChannel {
  sms
  whatsapp
  email
  inapp
}

enum NotificationCategory {
  order
  laundry
  snacks
  wallet
  promo
  account
}

enum ReferralStatus {
  pending
  joined
  rewarded
}

enum LoyaltyTier {
  bronze
  silver
  gold
  platinum
}

enum SupportChannel {
  chat
  call
  email
}

enum SupportTicketStatus {
  open
  in_progress @map("in-progress")
  resolved
  closed
}

enum SupportSender {
  user
  agent
}

enum CorporateInquiryStatus {
  new
  contacted
  quoted
  closed
}

enum SellerApplicationCategory {
  maker
  baker
  artist
  /// M19 — the common case now that the platform is food-first. Maps to
  /// `VendorType.maker` in `vendorTypeForCategory`; deliberately NOT a new
  /// `VendorType`, since the storefront renders identically and a new type
  /// would churn every discovery surface.
  home_chef
  other
}

enum SellerApplicationStatus {
  new
  reviewing
  waitlisted
  approved
  rejected
}

enum VendorType {
  maker
  baker
  artist
  homekrafted
}

enum DietaryTag {
  vegetarian
  vegan
  gluten_free   @map("gluten-free")
  sugar_free    @map("sugar-free")
  contains_nuts @map("contains-nuts")
}

enum ProductTag {
  Bestseller
  New
  Festive
  Curated
}

/// M20. What sort of thing a listing is.
///
/// `Product` was food-shaped throughout — `dietary`, `ingredients`,
/// `shelfLife`, `storageInstructions`, `isPackaged`, `defaultWeightSku` —
/// because until now everything on the platform was food. "Handcrafted
/// Gifts" (décor, candles, jewellery, art) is not.
///
/// One column rather than a second model, for exactly the reason M18 made a
/// hamper a `Product` instead of its own table: a craft still needs a
/// vendor, photos, price tiers, availability, moderation, reviews, cart,
/// checkout and search. A parallel `CraftProduct` re-derives every one of
/// those and then drifts from them. The food-only fields simply go unused,
/// and the UI branches on this.
enum ProductKind {
  food
  craft
}

/// M20. How far a listing can travel.
///
/// Food is `local`: it is cooked this morning and driven to you, so it is
/// gated on `distanceKm <= Vendor.deliveryRadiusKm` like everything before
/// it. A candle goes in the post, so `national` listings skip the radius
/// filter entirely and show with or without buyer coordinates.
///
/// Explicit rather than derived from `ProductKind`, because a kitchen
/// shipping pickles across India is a real case and deriving it would
/// forbid one.
enum ProductShippingScope {
  local
  national
}

enum ProductModerationStatus {
  active
  hidden
  flagged
}

enum GiftWrapStyle {
  kraft
  floral
  festive
  minimal
}

enum RibbonColor {
  gold
  terracotta
  pine
  ivory
}

enum OrderStatus {
  /// M8.1 seam for M8.2 (wallet debit / Razorpay capture): every order
  /// created by `POST /orders` starts here instead of `placed` — an order
  /// now exists in the DB (with stock already decremented + prices
  /// snapshotted) before payment is actually captured. M8.2's payment flow
  /// owns the `pending_payment` -> `placed` transition (or a failure/
  /// cancellation path that restocks) once the wallet debit / Razorpay
  /// charge succeeds — this milestone does not implement that transition.
  /// Not yet in the frontend mock's `OrderStatus` union
  /// (`client/lib/types/marketplace.ts`) — M8.4 must add
  /// `"pending-payment"` there when it swaps `POST /orders` in.
  pending_payment @map("pending-payment")
  placed
  confirmed
  packed
  shipped
  delivered
  cancelled
  returned
}

enum PaymentMethod {
  wallet
  razorpay
  cod
}

enum RefundStatus {
  none
  requested
  processing
  refunded
}

enum WalletTransactionDirection {
  credit
  debit
}

enum WalletTransactionCategory {
  topup
  cashback
  refund
  payment
  referral
  loyalty
  adjustment
}

enum WalletTransactionRefType {
  order
  laundryBooking
  topup
  referral
  loyalty
  support
  mealSubscription
}

enum AutoTopupTrigger {
  below_threshold @map("below-threshold")
  scheduled
}

/// M8.2 — what a `RazorpayOrder` row was opened to pay for: an existing
/// Homekrafted `Order` (amount = `Order.total`, re-read server-side) or a
/// wallet top-up (amount = the shopper's declared top-up amount — safe to
/// accept from the client here because Razorpay itself enforces that only
/// a payment of exactly this order's amount can ever capture against it;
/// the wallet is only ever credited once our own webhook handler verifies
/// the HMAC and reads *this* row's stored `amount`, never anything in the
/// webhook payload).
enum RazorpayOrderPurpose {
  order
  topup
}

enum RazorpayOrderStatus {
  created
  captured
  failed
}

enum LaundryPricingModel {
  per_kg   @map("per-kg")
  per_item @map("per-item")
  per_hour @map("per-hour")
}

enum LaundryBookingStatus {
  scheduled
  picked_up        @map("picked-up")
  in_progress      @map("in-progress")
  out_for_delivery @map("out-for-delivery")
  delivered
  cancelled
}

enum LaundrySubscriptionPlan {
  weekly
  biweekly
  monthly
}

enum SnackCategory {
  savoury
  sweet
  baked
  namkeen
}

enum DietType {
  veg
  non_veg @map("non-veg")
}

/// Which meal of the day a `MealPlan` covers. Deliberately not a free
/// string: the delivery bracket a buyer may pick is derived per meal, and
/// a kitchen offering "lunch" and "Lunch" would split its own capacity.
enum MealType {
  breakfast
  lunch
  dinner
}

/// `paused` is the buyer's own hold and is reversible; `cancelled` is
/// terminal and `expired` is what a cycle running out of meals becomes.
/// Kept apart because only `paused` should still occupy a kitchen's
/// capacity — somebody away for a week has not given up their seat.
enum MealSubscriptionStatus {
  active
  paused
  cancelled
  expired
}

/// One row per meal a subscription owes. `skipped` is the buyer saying
/// "not tomorrow"; `unavailable` is the kitchen being closed that day.
/// Both return the meal to the cycle, but only one is the buyer's doing,
/// and a kitchen's reliability cannot be read off a column that conflates
/// them.
enum MealDeliveryStatus {
  scheduled
  skipped
  unavailable
  delivered
  cancelled
}

enum SnackListStatus {
  draft
  sent
  received
  accepted
  out_for_delivery @map("out-for-delivery")
  delivered
}

enum SnackOrderStatus {
  received
  accepted
  out_for_delivery @map("out-for-delivery")
  delivered
}

/// `SnackOrder.channel` is a one-value union in lib/types ("whatsapp") —
/// kept as its own enum (not a boolean) so a future channel is a value
/// addition, not a shape change, per that type's own doc comment.
enum SnackOrderChannel {
  whatsapp
}

/// What a HomeKrafter makes or offers. This is a **discovery/display tag,
/// not a role** — every HomeKrafter has the same single role and the same
/// full set of portal modules. Nothing in `server/src/seller/*` may branch
/// on this to decide access; it exists so buyers can filter ("show me
/// bakers near me") and so a kitchen can say what it does.
enum SellerSpecialty {
  homemade_food
  bakery
  pickles_preserves
  snacks
  sweets
  crafts
  laundry
  cleaning
}

enum SellerStatus {
  pending
  approved
  suspended
}

enum PayoutStatus {
  pending
  paid
  /// M15. A HomeKrafter could request a payout since M8.3b, but nothing
  /// could ever settle or refuse one — there was no admin surface at all,
  /// so `pending` was a terminal state in practice. Rejection needs to be
  /// expressible (wrong bank details, an account under review) without
  /// deleting the request and losing the record that it was made.
  rejected
}

// ---------------------------------------------------------------------------
// Shared / account layer
// ---------------------------------------------------------------------------

/// Modeling note: lib/types' `User.walletId`/`User.loyaltyAccountId` (FKs
/// pointing "down" to Wallet/LoyaltyAccount, which themselves also carry
/// `userId`) collapse into a single Prisma-idiomatic 1:1 relation each,
/// declared from the Wallet/LoyaltyAccount side — no redundant bidirectional
/// FK. `authProviders`/`role`/etc. map straight across.
model User {
  id                String         @id @default(cuid())
  name              String
  email             String?        @unique
  phone             String?        @unique
  /// Only set for the email+password auth flow; null for phone-OTP-only or
  /// social-only accounts.
  passwordHash      String?
  avatarPlaceholder String?
  authProviders     AuthProvider[]
  createdAt         DateTime       @default(now())
  role              UserRole       @default(consumer)
  /// M11a admin suspend/reactivate flag — see lib/types/shared.ts's doc
  /// comment. Unlike the M0–M11a mock, this DOES gate sign-in for real
  /// once wired (auth.service checks it) — that's the real-backend upgrade
  /// the frontend note calls out as still owed.
  suspended         Boolean        @default(false)
  referralCode      String         @unique
  referredByCode    String?

  wallet                  Wallet?
  loyaltyAccount          LoyaltyAccount?
  addresses               Address[]
  reviews                 Review[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  referralsSent           Referral[]               @relation("ReferralsSent")
  referralsReceived       Referral[]               @relation("ReferralsReceived")
  supportTickets          SupportTicket[]
  cart                    Cart?
  wishlist                Wishlist?
  hampers                 Hamper[]
  orders                  Order[]
  laundryBookings         LaundryBooking[]
  laundrySubscriptions    LaundrySubscription[]
  snackLists              SnackList[]
  mealSubscriptions       MealSubscription[]
  seller                  Seller?
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  socialAccounts          SocialAccount[]
  vendorFollows           VendorFollow[]
  razorpayOrders          RazorpayOrder[]
  adminAuditLogs          AdminAuditLog[]
  /// Payouts this admin settled or refused — see `Payout.decidedById`.
  payoutDecisions         Payout[]                 @relation("PayoutDecidedBy")

  @@index([role])
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String
  recipientName String
  phone         String
  line1         String
  line2         String?
  city          String
  state         String
  pincode       String
  country       String   @default("India")
  isDefault     Boolean  @default(false)
  /// Set when the buyer allows the browser location prompt or picks an area
  /// at checkout. Null is normal (typed address, permission denied).
  lat           Float?
  lng           Float?
  area          String?
  instructions  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cartItems             CartItem[]
  orderItemsShippedTo   OrderItem[]
  shipments             OrderShipment[]  @relation("ShipmentAddress")
  hampersAsRecipient    Hamper[]         @relation("HamperRecipientAddress")
  mealSubscriptions     MealSubscription[]
  ordersAsGiftRecipient Order[]          @relation("OrderGiftRecipientAddress")
  laundryBookings       LaundryBooking[]

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Auth infrastructure (not a lib/types entity — server-only, backs the
// JWT access+refresh / phone-OTP / social flows described in the milestone
// brief).
// ---------------------------------------------------------------------------

/// One row per issued refresh token (rotating). A login/refresh mints a new
/// row; refreshing revokes the old one and stores `replacedByTokenId`, so a
/// reused/stolen refresh token is detectable (already-revoked lookup).
/// Only a hash is stored — never the raw token.
model RefreshToken {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  createdByIp       String?
  createdAt         DateTime  @default(now())

  @@index([userId])
}

/// Phone-OTP login/verify. `codeHash` (never the raw code) + short TTL +
/// `attempts` counter for basic brute-force resistance on top of the global
/// throttler. The OTP "sender" is a stub in M8.0 (logs to console) — see
/// `src/auth/otp.service.ts`.
/// M18 — one row per "forgot password" request.
///
/// Stored as a SHA-256 of the token, not the token itself: the emailed
/// value is a bearer credential for the account, so a leaked database dump
/// must not be a pile of working reset links. SHA-256 rather than argon2
/// for the same reason `RefreshToken` uses it — this is an exact-equality
/// index lookup, not a password verification, and the token is 32 random
/// bytes rather than something guessable.
///
/// Single-use (`consumedAt`) and short-lived (`expiresAt`). Rows are kept
/// after consumption rather than deleted so a support question about a
/// reset has an answer.
model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PhoneOtp {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  purpose    String    @default("login")
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone])
}

/// Stub social-login linkage — one row per (provider, providerAccountId) a
/// user has connected. M8.0's `/auth/social/:provider` endpoint is a stub
/// (trusts a client-submitted profile payload instead of verifying a real
/// OAuth token) — flagged in `auth.service.ts`; a real provider SDK
/// (Google/Apple) verification swaps in without a schema change.
model SocialAccount {
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          SocialProvider
  providerAccountId String
  createdAt         DateTime       @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

/// `targetType`/`targetId` stay a loosely-typed polymorphic pair (not
/// FK-enforced) per docs/DATA-MODEL.md's explicit note — `targetId` can
/// point at a Product, Vendor, or a (not-yet-modeled) service id.
/// `sellerReply` (an embedded object in lib/types) flattens to two nullable
/// columns, present together or not at all (app-level invariant).
model Review {
  id                   String           @id @default(cuid())
  targetType           ReviewTargetType
  targetId             String
  userId               String
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName             String
  rating               Int
  title                String?
  body                 String
  createdAt            DateTime         @default(now())
  helpfulCount         Int              @default(0)
  verifiedPurchase     Boolean          @default(false)
  sellerReplyBody      String?
  sellerReplyCreatedAt DateTime?
  flagged              Boolean          @default(false)
  hidden               Boolean          @default(false)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  category  NotificationCategory
  title     String
  body      String
  read      Boolean              @default(false)
  createdAt DateTime             @default(now())
  /// Polymorphic ref, not FK-enforced (order id / laundry booking id /
  /// wallet transaction id / support ticket id) — see docs/DATA-MODEL.md.
  refType   String?
  refId     String?

  @@index([userId, read])
}

model NotificationPreference {
  id       String               @id @default(cuid())
  userId   String
  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category NotificationCategory
  sms      Boolean              @default(false)
  whatsapp Boolean              @default(false)
  email    Boolean              @default(false)
  inapp    Boolean              @default(true)

  @@unique([userId, category])
}

// ---------------------------------------------------------------------------
// Referral & loyalty
// ---------------------------------------------------------------------------

model Referral {
  id             String         @id @default(cuid())
  referrerUserId String
  referrer       User           @relation("ReferralsSent", fields: [referrerUserId], references: [id], onDelete: Cascade)
  code           String
  refereeName    String?
  refereeUserId  String?
  referee        User?          @relation("ReferralsReceived", fields: [refereeUserId], references: [id])
  status         ReferralStatus @default(pending)
  rewardAmount   Decimal?       @db.Decimal(10, 2)
  createdAt      DateTime       @default(now())

  @@index([referrerUserId])
}

model LoyaltyAccount {
  id               String      @id @default(cuid())
  userId           String      @unique
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier             LoyaltyTier @default(bronze)
  points           Int         @default(0)
  lifetimePoints   Int         @default(0)
  pointsToNextTier Int?
}

// ---------------------------------------------------------------------------
// Support
// ---------------------------------------------------------------------------

model SupportTicket {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  channel   SupportChannel
  status    SupportTicketStatus @default(open)
  orderRef  String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  messages  SupportMessage[]

  @@index([userId])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender    SupportSender
  body      String
  createdAt DateTime      @default(now())

  @@index([ticketId])
}

// ---------------------------------------------------------------------------
// Corporate inquiry & seller applications (both standalone — may predate an
// account, per lib/types' own doc comments).
// ---------------------------------------------------------------------------

model CorporateInquiry {
  id                String                 @id @default(cuid())
  companyName       String
  contactName       String
  email             String
  phone             String
  occasion          String?
  estimatedQuantity Int
  budgetRange       String?
  message           String
  status            CorporateInquiryStatus @default(new)
  createdAt         DateTime               @default(now())
}

/// The one way in. Everyone who wants to sell fills this in at `/sell`; an
/// admin approves it and that creates the `User` (if new), the `Vendor` and
/// the `Seller`. There is no self-serve HomeKrafter signup.
model SellerApplication {
  id               String                    @id @default(cuid())
  businessName     String
  contactName      String
  email            String
  phone            String
  category         SellerApplicationCategory
  /// What they intend to offer. Carried onto `Seller.specialties` on approval.
  specialties      SellerSpecialty[]
  city             String
  /// Tricity area id from `server/src/common/geo.ts#TRICITY_AREAS`, or the
  /// literal `"other"`. Decides the coordinates the new Vendor is created
  /// with, which is what buyers' distance filter measures against.
  ///
  /// **An area that does not resolve makes the application unapprovable**
  /// (M19). `approveApplication` refuses it rather than falling back to the
  /// tricity centroid — that fallback planted every out-of-area kitchen at
  /// Chandigarh's exact centre, so it sorted as ~0 km from every buyer and
  /// passed every radius filter. An admin assigns a real area first.
  area             String
  /// Free text, required when `area` is `"other"`: the locality they typed.
  /// Captures expansion demand without promising delivery there.
  areaLabel        String?
  /// How far they're willing to deliver, in km. **Nullable on purpose**
  /// (M19): with a non-null default of 10, `approveApplication`'s
  /// `deliveryRadiusKm || defaultRadiusKm` always saw a truthy 10 and the
  /// platform default was unreachable. Null means "they didn't say", which
  /// is the only thing that lets the platform setting apply.
  deliveryRadiusKm Int?
  description      String
  status           SellerApplicationStatus   @default(new)
  /// Set when an admin rejects or waitlists, shown back to the applicant.
  decisionNote     String?
  createdAt        DateTime                  @default(now())
}

// ---------------------------------------------------------------------------
// Wallet
// ---------------------------------------------------------------------------

model Wallet {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance              Decimal  @default(0) @db.Decimal(12, 2)
  pendingCashback      Decimal  @default(0) @db.Decimal(12, 2)
  lifetimeSaved        Decimal  @default(0) @db.Decimal(12, 2)
  payWithWalletDefault Boolean  @default(true)
  updatedAt            DateTime @updatedAt

  transactions   WalletTransaction[]
  autoTopupRule  AutoTopupRule?
  razorpayOrders RazorpayOrder[]
}

/// `balanceAfter` is the server-authoritative running total — per
/// docs/DATA-MODEL.md, only ever written inside the same DB transaction
/// that mutates `Wallet.balance` (M8.2 wallet-service concern; this
/// milestone only lays the table down).
model WalletTransaction {
  id           String                     @id @default(cuid())
  walletId     String
  wallet       Wallet                     @relation(fields: [walletId], references: [id], onDelete: Cascade)
  direction    WalletTransactionDirection
  category     WalletTransactionCategory
  amount       Decimal                    @db.Decimal(12, 2)
  balanceAfter Decimal                    @db.Decimal(12, 2)
  title        String
  refType      WalletTransactionRefType?
  refId        String?
  createdAt    DateTime                   @default(now())

  @@index([walletId, createdAt])
}

model AutoTopupRule {
  id               String           @id @default(cuid())
  walletId         String           @unique
  wallet           Wallet           @relation(fields: [walletId], references: [id], onDelete: Cascade)
  enabled          Boolean          @default(false)
  trigger          AutoTopupTrigger
  thresholdAmount  Decimal?         @db.Decimal(12, 2)
  topupAmount      Decimal          @db.Decimal(12, 2)
  paymentMethodRef String?
}

/// M8.2 — a client-supplied key (`Idempotency-Key` header, typically) that
/// scopes a money-mutating op to "run at most once". The op runs inside a
/// transaction that inserts its claim row here *before* doing the real
/// work and stamps the same row with the JSON result once done, all
/// atomically — see `src/common/idempotency/idempotency.service.ts` for
/// the full mechanics (relies on Postgres' own unique-index conflict
/// handling to serialize concurrent duplicate attempts, no polling).
model IdempotencyKey {
  id           String   @id @default(cuid())
  userId       String
  scope        String
  key          String
  responseBody Json
  createdAt    DateTime @default(now())

  @@unique([userId, scope, key])
}

/// M8.2 — dedup ledger for inbound Razorpay webhook deliveries. Razorpay
/// (like most webhook senders) may redeliver the same event on a timeout
/// or non-2xx response; a unique violation on insert here is exactly the
/// signal "already processed this one" — see `PaymentsService.handleWebhook`.
model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String   @default("razorpay")
  eventId     String
  paymentId   String?
  processedAt DateTime @default(now())

  @@unique([provider, eventId])
}

/// M8.2 — one row per Razorpay order we've opened (`POST
/// /payments/razorpay/order`), tracking what it's *for* so the webhook
/// handler knows what to credit/transition on `payment.captured` without
/// trusting anything in the webhook payload beyond the payment id itself.
/// `orderId` is set when `purpose: "order"`, `walletId` when `purpose:
/// "topup"` — same app-level XOR convention as `CartItem`'s
/// product-or-hamper polymorphic line.
model RazorpayOrder {
  id              String               @id @default(cuid())
  razorpayOrderId String               @unique
  purpose         RazorpayOrderPurpose
  amount          Decimal              @db.Decimal(12, 2)
  userId          String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId         String?
  order           Order?               @relation(fields: [orderId], references: [id])
  walletId        String?
  wallet          Wallet?              @relation(fields: [walletId], references: [id])
  status          RazorpayOrderStatus  @default(created)
  createdAt       DateTime             @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Marketplace: vendors, catalog, cart/wishlist, hampers, orders
// ---------------------------------------------------------------------------

model Vendor {
  id                String     @id @default(cuid())
  slug              String     @unique
  name              String
  type              VendorType
  bio               String
  avatarPlaceholder String
  bannerPlaceholder String
  avatarSrc         String?
  bannerSrc         String?
  /// Human-readable address line shown on the storefront ("Sector 35, Chandigarh").
  location          String
  /// Tricity area this kitchen sits in — the value a buyer picks in the
  /// manual area picker when they decline the browser location prompt.
  area              String
  /// Kitchen coordinates. Distance to a buyer is computed with haversine
  /// (`server/src/common/geo.ts`); a listing is shown when that distance is
  /// within `deliveryRadiusKm`.
  lat               Float
  lng               Float
  /// How far this HomeKrafter is willing to deliver. They control it from
  /// their storefront settings.
  deliveryRadiusKm  Int        @default(10)
  rating            Decimal    @default(0) @db.Decimal(2, 1)
  reviewCount       Int        @default(0)
  followerCount     Int        @default(0)
  joinedAt          DateTime   @default(now())

  products  Product[]
  seller    Seller?
  mealPlans MealPlan[]
  follows   VendorFollow[]
  profile   VendorProfile?
  photos    VendorPhoto[]
  blackouts VendorBlackoutDate[]
}

/// M16 (M2). A day this kitchen is not taking orders — a festival they
/// are cooking for their own family, travel, a sold-out batch.
///
/// Stored as a **list of specific dates**, not a recurring rule: the
/// weekly pattern already exists as `VendorProfile.workingDays`, and what
/// this covers is the exception to it. A recurrence here would collide
/// with that and make "am I open on the 14th" answerable two ways.
///
/// Deliberately separate from `Product.isAvailable` (the HomeKrafter's
/// per-item switch) and `moderationStatus` (the admin's) — this is about
/// *when*, and merging any of the three would make one switch silently
/// override another.
model VendorBlackoutDate {
  id       String   @id @default(cuid())
  vendorId String
  vendor   Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  /// Date only, stored at UTC midnight. A blackout is a whole day —
  /// nobody blocks out 14:00–16:00 on a Tuesday.
  date     DateTime @db.Date
  /// Shown to buyers on the picker ("Closed — Diwali"), so keep it short.
  reason   String?

  @@unique([vendorId, date])
  @@index([vendorId, date])
}

/// M16 (H5). Everything a buyer wants to know before trusting a stranger's
/// kitchen, kept **off** `Vendor` on purpose: `Vendor` is the catalogue
/// entity, read on every product card, every distance filter and every
/// listing query, and none of those need a shop's story or its return
/// policy. A 1:1 optional table means the profile is loaded only by the
/// storefront and the seller editor, and "has this HomeKrafter filled
/// anything in" is answerable by the row's existence.
///
/// **The verification flags are admin-only.** A HomeKrafter submits an
/// FSSAI number; an admin decides whether the badge appears. The badge is
/// the entire point of the panel, so the write path for it is
/// `PATCH /admin/sellers/:id/verification`, never `PATCH /seller/profile`
/// — see `SellerProfileService.updateOwn`, which strips them.
///
/// Nothing derived is stored here. Trust score, achievements and profile
/// completion are all computed from rows on read
/// (`VendorProfileService`), for the same reason M15's rating aggregates
/// are recomputed rather than incremented: a stored trust score is a
/// number that silently stops being true.
model VendorProfile {
  vendorId String @id
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  // --- Story: who is behind the kitchen ---------------------------------
  /// One line under the name. Not `bio` — `bio` is the catalogue blurb.
  tagline   String?
  /// Long-form. The "we started this in 2019 with my mother's recipe" text.
  story     String?
  /// Free-text dish/craft names this kitchen is known for. Display only —
  /// discovery still runs off `Seller.specialties` and `Category`.
  knownFor  String[]
  /// Languages the HomeKrafter can take an order in. Real friction in the
  /// tricity: a buyer who can only phone in Punjabi needs to know.
  languages String[]

  // --- Operations: what ordering from them is actually like -------------
  /// Typical time from order to ready, in minutes. Feeds the pre-order
  /// slot suggestion (M2) and sets the buyer's expectation on the listing.
  prepTimeMins     Int?
  /// Self-declared "I usually reply within". Shown as declared, not as
  /// measured — we do not track message latency yet, and claiming a
  /// measured number we do not measure would be a lie on a trust panel.
  responseTimeMins Int?
  /// How many orders a day this kitchen can take. A home cook's ceiling is
  /// real and low; surfacing it is what stops a festival rush from
  /// producing a hundred cancellations.
  capacityPerDay   Int?
  minOrderValue    Decimal? @db.Decimal(10, 2)
  /// Days of the week the kitchen works, 0 = Sunday. Empty = unspecified,
  /// which the UI reads as "no set days", not "closed".
  workingDays      Int[]
  /// "09:00" / "19:30", local time, stored as strings for the same reason
  /// `LaundrySlot` windows are: they are a label, not an instant.
  opensAt          String?
  closesAt         String?

  // --- Policies: what a dispute gets decided on -------------------------
  cancellationPolicy  String?
  returnPolicy        String?
  customOrderPolicy   String?
  acceptsCustomOrders Boolean @default(false)
  packagingNote       String?
  /// How the kitchen handles hygiene — gloves, sealed packing, FSSAI
  /// practices. The single most asked question about home food.
  hygieneNote         String?

  // --- Verification: admin writes only ----------------------------------
  /// As submitted by the HomeKrafter. Present + `fssaiVerified` false means
  /// "claimed, not checked" — the UI must never render that as a badge.
  fssaiNumber      String?
  fssaiExpiry      DateTime?
  fssaiVerified    Boolean   @default(false)
  identityVerified Boolean   @default(false)
  addressVerified  Boolean   @default(false)
  /// When an admin last touched any of the three flags above, and why.
  verifiedAt       DateTime?
  verificationNote String?

  // --- Social ------------------------------------------------------------
  instagramUrl String?
  facebookUrl  String?
  youtubeUrl   String?
  websiteUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum VendorPhotoKind {
  kitchen
  process
  team
  award
}

/// M16 (H5). Photos of the kitchen itself, separate from `Product.images`.
/// A list rather than columns on `VendorProfile` because the count is
/// open-ended and ordering matters — the same reason `ProductImage` is its
/// own table. Uploaded through `<PhotoUpload>` (M14), so `url` is stored,
/// never the storage key.
model VendorPhoto {
  id        String          @id @default(cuid())
  vendorId  String
  vendor    Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  kind      VendorPhotoKind @default(kitchen)
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())

  @@index([vendorId, sortOrder])
}

/// Not a lib/types entity yet — `Vendor.isFollowing` is a per-viewer
/// derived flag in the mock layer with nothing backing it; a real "follow"
/// feature needs a join table, so this is added now rather than bolted on
/// later. `isFollowing` for a given viewer = `exists(VendorFollow{userId,
/// vendorId})`.
model VendorFollow {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, vendorId])
}

model Category {
  id               String  @id @default(cuid())
  slug             String  @unique
  name             String
  imagePlaceholder String
  imageSrc         String?
  productCount     Int     @default(0)
  /// M20. Which side of the catalogue this belongs to — the header splits
  /// "Homemade Food" from "Handcrafted Gifts", and a category has to say
  /// which one it is. Defaults to `food`: everything that existed before
  /// this column was food.
  group            ProductKind @default(food)
  /// M20. Display order on the home page's category tiles. Ties fall back
  /// to name, so an unset value is stable rather than random.
  sortOrder        Int         @default(0)

  products Product[]

  @@index([group, sortOrder])
}

model Occasion {
  id      String @id @default(cuid())
  slug    String @unique
  name    String
  initial String

  /// M16 (H8). The next date this occasion actually falls on, as an
  /// absolute date an admin sets — **not** a recurrence rule. Indian
  /// festivals move against the Gregorian calendar every year (Diwali is
  /// lunisolar), so a `MM-DD` field or a "repeats yearly" flag would be
  /// wrong for exactly the occasions that matter most here. `null` means
  /// evergreen: a birthday has no season, and the hub lists those
  /// separately rather than sorting them into a countdown they don't have.
  celebratedOn DateTime?
  /// One line for the hub card ("Lamps, sweets and a lot of relatives").
  tagline      String?
  imageSrc     String?

  products    ProductOccasion[]
  collections Collection[]
}

model Collection {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String?
  occasionId  String?
  occasion    Occasion? @relation(fields: [occasionId], references: [id])

  /// M16 (H8). A `Collection` is a gift guide with its own page
  /// (`/guides/[slug]`), not just the curated ordering behind an occasion
  /// page — so it needs its own art and its own place in a running order.
  /// `featured` is what the hub and the home rail promote.
  imageSrc  String?
  featured  Boolean @default(false)
  sortOrder Int     @default(0)

  products CollectionProduct[]
}

/// `Collection.productIds` (an ordered id array in the mock) becomes a real
/// join table; `sortOrder` preserves the array's display order per
/// docs/DATA-MODEL.md's note ("array order is the collection's real display
/// order").
model CollectionProduct {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder    Int        @default(0)

  @@unique([collectionId, productId])
}

/// `dietary`/`tags` stay native Postgres enum arrays (small, fixed tag
/// sets — not full entities, so a join table doesn't pay for itself).
/// `occasionIds` (many-to-many with real query patterns — "products for
/// this occasion") gets a proper join table (`ProductOccasion`) instead.
model Product {
  id                  String                  @id @default(cuid())
  slug                String                  @unique
  vendorId            String
  vendor              Vendor                  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name                String
  categoryId          String
  category            Category                @relation(fields: [categoryId], references: [id])
  /// M20. Food or craft — see `ProductKind`. Defaults to `food` so every
  /// row that existed before this column keeps its meaning without a
  /// backfill.
  kind                ProductKind             @default(food)
  /// M20. Local delivery or posted nationally — see `ProductShippingScope`.
  /// Defaults to `local`, which is what every pre-M20 listing was.
  shippingScope       ProductShippingScope    @default(local)
  dietary             DietaryTag[]
  defaultWeightSku    String
  rating              Decimal                 @default(0) @db.Decimal(2, 1)
  reviewCount         Int                     @default(0)
  tags                ProductTag[]
  isPackaged          Boolean                 @default(true)
  cashbackPct         Decimal                 @default(0) @db.Decimal(4, 2)
  description         String
  ingredients         String?
  shelfLife           String?
  storageInstructions String?
  madeIn              String?
  moderationStatus    ProductModerationStatus @default(active)
  /// HomeKrafter-controlled "am I making this right now" switch, toggled
  /// from the portal's Availability panel. Distinct from `moderationStatus`,
  /// which is admin-controlled: an item can be perfectly allowed but simply
  /// not being cooked today. Unavailable items stay off the storefront and
  /// out of search.
  isAvailable         Boolean                 @default(true)
  featured            Boolean                 @default(false)
  /// M18 — "this listing is a ready-made gift hamper", set by the
  /// HomeKrafter who lists it.
  ///
  /// A hamper is a `Product`, not a new entity, and this flag is the whole
  /// of the difference. It already needed a vendor, photos, price tiers,
  /// availability, moderation, reviews, cart, checkout and search; a
  /// parallel model would have re-derived every one of those and then
  /// drifted from them. The flag is a *listing* attribute rather than a
  /// `Category`, because a hamper is still a sweets or pickles hamper —
  /// overloading the browse taxonomy would force a false choice between
  /// the two.
  ///
  /// Unrelated to the `Hamper` model below, which is the retired
  /// buyer-assembled gift box (M3) kept only so historical orders still
  /// resolve.
  isHamper            Boolean                 @default(false)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  images        ProductImage[]
  weightOptions WeightOption[]
  occasions     ProductOccasion[]
  collections   CollectionProduct[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]
  hamperItems   HamperItem[]

  @@index([vendorId])
  @@index([categoryId])
  @@index([isHamper])
}

model ProductOccasion {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  occasionId String
  occasion   Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)

  @@unique([productId, occasionId])
}

model ProductImage {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  placeholder String
  src         String?
  ratio       String
  sortOrder   Int     @default(0)

  @@index([productId])
}

model WeightOption {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String  @unique
  label     String
  price     Decimal @db.Decimal(10, 2)
  mrp       Decimal @db.Decimal(10, 2)
  stock     Int     @default(0)

  @@index([productId])
}

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  items CartItem[]
}

/// Polymorphic line per docs/DATA-MODEL.md: either a catalog product
/// (`productId`+`sku`) or an assembled hamper (`hamperId`) — never both.
/// Modeled as two nullable FKs + an app-level XOR (enforced in the M8.1
/// cart service; a DB CHECK constraint is a reasonable follow-up once
/// there's real write traffic to protect).
model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  sku       String?
  hamperId  String?
  hamper    Hamper?  @relation(fields: [hamperId], references: [id])
  quantity  Int      @default(1)
  giftWrap  Boolean  @default(false)
  addressId String?
  address   Address? @relation(fields: [addressId], references: [id])

  @@index([cartId])
}

model Wishlist {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  addedAt    DateTime @default(now())

  @@unique([wishlistId, productId])
}

model HamperBox {
  id         String  @id @default(cuid())
  name       String
  maxItems   Int
  price      Decimal @db.Decimal(10, 2)
  itemsLabel String

  hampers Hamper[]
}

model Hamper {
  id                 String         @id @default(cuid())
  userId             String
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  boxId              String
  box                HamperBox      @relation(fields: [boxId], references: [id])
  giftNote           String?
  wrap               GiftWrapStyle?
  ribbon             RibbonColor?
  nameCard           String?
  recipientAddressId String?
  recipientAddress   Address?       @relation("HamperRecipientAddress", fields: [recipientAddressId], references: [id])
  hidePrice          Boolean        @default(false)
  createdAt          DateTime       @default(now())

  items      HamperItem[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([userId])
}

model HamperItem {
  id        String  @id @default(cuid())
  hamperId  String
  hamper    Hamper  @relation(fields: [hamperId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
}

/// `OrderGift` (an embedded object in lib/types) flattens onto Order with a
/// `gift`-prefixed column set — present together or not at all
/// (`giftIsGift: false` is the "no gift" state, matching the mock's
/// `gift?: OrderGift` optionality). `shippingAddressIds` stays a
/// denormalized `String[]` convenience list per docs/DATA-MODEL.md;
/// `OrderShipment` (below) is the real source of truth for per-address
/// delivery dates.
model Order {
  id                     String        @id @default(cuid())
  orderNumber            String        @unique
  userId                 String
  user                   User          @relation(fields: [userId], references: [id])
  status                 OrderStatus   @default(placed)
  shippingAddressIds     String[]
  giftIsGift             Boolean       @default(false)
  giftRecipientName      String?
  giftRecipientAddressId String?
  giftRecipientAddress   Address?      @relation("OrderGiftRecipientAddress", fields: [giftRecipientAddressId], references: [id])
  giftHidePrice          Boolean       @default(false)
  giftMessage            String?
  placedAt               DateTime      @default(now())
  subtotal               Decimal       @db.Decimal(12, 2)
  shippingFee            Decimal       @default(0) @db.Decimal(12, 2)
  total                  Decimal       @db.Decimal(12, 2)
  walletApplied          Decimal       @default(0) @db.Decimal(12, 2)
  cashbackEarned         Decimal       @default(0) @db.Decimal(12, 2)
  refundStatus           RefundStatus  @default(none)
  /// Why the buyer asked for their money back, in their own words, and
  /// when. Set by `POST /orders/:id/cancel` and `POST /orders/:id/return`
  /// (M15) — before that, `RefundStatus.requested` existed in the enum
  /// with no path in the product that could reach it, so every refund was
  /// something an admin started with no record of what the buyer said.
  refundReason           String?
  refundRequestedAt      DateTime?
  /// When the HomeKrafter marked it delivered. The return window counts
  /// from here, not from `placedAt` — those can be a week apart on a
  /// made-to-order item, and counting from the wrong one either closes
  /// the window before the food arrives or leaves it open far too long.
  /// Null on rows that reached `delivered` before M15 added this.
  deliveredAt            DateTime?
  /// Set when the order is cancelled, by the buyer or an admin. Distinct
  /// from `refundRequestedAt`: a `pending-payment` order can be cancelled
  /// with no money involved at all.
  cancelledAt            DateTime?
  paymentMethod          PaymentMethod

  items          OrderItem[]
  shipments      OrderShipment[]
  razorpayOrders RazorpayOrder[]

  @@index([userId])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  sku       String?
  hamperId  String?
  hamper    Hamper?  @relation(fields: [hamperId], references: [id])
  name      String
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)
  addressId String
  address   Address  @relation(fields: [addressId], references: [id])
  giftWrap  Boolean  @default(false)

  @@index([orderId])
}

model OrderShipment {
  id           String    @id @default(cuid())
  orderId      String
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  addressId    String
  address      Address   @relation("ShipmentAddress", fields: [addressId], references: [id])
  deliveryDate DateTime?

  @@unique([orderId, addressId])
}

// ---------------------------------------------------------------------------
// Laundry, Cleaning & Ironing
// ---------------------------------------------------------------------------

/// Availability lookup tables — not booking state, just what the picker UI
/// offers (see lib/types/laundry.ts's own "availability data, not booking
/// state" framing).
model LaundryDay {
  id      String   @id @default(cuid())
  day     String
  date    String
  isoDate DateTime
}

model LaundrySlot {
  id    String @id @default(cuid())
  label String

  pickupBookings   LaundryBooking[]      @relation("PickupSlot")
  deliveryBookings LaundryBooking[]      @relation("DeliverySlot")
  subscriptions    LaundrySubscription[]
}

model LaundryService {
  id              String              @id @default(cuid())
  slug            String              @unique
  name            String
  description     String
  pricingModel    LaundryPricingModel
  price           Decimal             @db.Decimal(10, 2)
  unitLabel       String
  priceIsFrom     Boolean             @default(false)
  priceLabel      String
  iconPlaceholder String?

  lines         LaundryBookingLine[]
  subscriptions LaundrySubscription[]
}

/// `pickupSlot`/`deliverySlot` (embedded `{date, slotId}` objects in
/// lib/types) flatten to a date column + a `LaundrySlot` FK each, named by
/// relation (`PickupSlot`/`DeliverySlot`) since both point at the same
/// model. `partnerId` (M10b) scopes a booking to a laundry-type `Seller`.
model LaundryBooking {
  id                  String               @id @default(cuid())
  bookingNumber       String               @unique
  userId              String
  user                User                 @relation(fields: [userId], references: [id])
  pickupDate          DateTime
  pickupSlotId        String
  pickupSlot          LaundrySlot          @relation("PickupSlot", fields: [pickupSlotId], references: [id])
  deliveryDate        DateTime
  deliverySlotId      String
  deliverySlot        LaundrySlot          @relation("DeliverySlot", fields: [deliverySlotId], references: [id])
  addressId           String
  address             Address              @relation(fields: [addressId], references: [id])
  photos              String[]
  specialInstructions String?
  subscriptionId      String?
  subscription        LaundrySubscription? @relation(fields: [subscriptionId], references: [id])
  paymentMethod       PaymentMethod
  status              LaundryBookingStatus @default(scheduled)
  estimatedTotal      Decimal              @db.Decimal(12, 2)
  walletCashback      Decimal?             @db.Decimal(12, 2)
  createdAt           DateTime             @default(now())
  partnerId           String?
  partner             Seller?              @relation(fields: [partnerId], references: [id])

  lines LaundryBookingLine[]

  @@index([userId])
  @@index([partnerId])
}

model LaundryBookingLine {
  id                String         @id @default(cuid())
  bookingId         String
  booking           LaundryBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceId         String
  service           LaundryService @relation(fields: [serviceId], references: [id])
  estimatedWeightKg Decimal?       @db.Decimal(6, 2)
  itemCount         Int?
  estimatedHours    Decimal?       @db.Decimal(6, 2)
  estimatedPrice    Decimal        @db.Decimal(10, 2)
}

model LaundrySubscription {
  id         String                  @id @default(cuid())
  userId     String
  user       User                    @relation(fields: [userId], references: [id])
  serviceId  String
  service    LaundryService          @relation(fields: [serviceId], references: [id])
  plan       LaundrySubscriptionPlan
  slotDay    String
  slotId     String
  slot       LaundrySlot             @relation(fields: [slotId], references: [id])
  active     Boolean                 @default(true)
  nextPickup DateTime

  bookings LaundryBooking[]

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Snacks & food (full meals are promo-only — MealPromo is static content,
// no menu/order entities per lib/channel.ts)
// ---------------------------------------------------------------------------

model Snack {
  id               String        @id @default(cuid())
  slug             String        @unique
  name             String
  description      String
  price            Decimal       @db.Decimal(10, 2)
  category         SnackCategory
  diet             DietType
  imagePlaceholder String
  imageSrc         String?
  available        Boolean       @default(true)
  sellerId         String?
  seller           Seller?       @relation(fields: [sellerId], references: [id])

  snackListItems  SnackListItem[]
  snackOrderItems SnackOrderItem[]

  @@index([sellerId])
}

/// The customer's in-progress selection that becomes a WhatsApp payload —
/// never becomes an `Order` (Snacks has no on-site checkout, see
/// lib/channel.ts).
model SnackList {
  id              String          @id @default(cuid())
  userId          String?
  user            User?           @relation(fields: [userId], references: [id])
  estimateTotal   Decimal         @db.Decimal(10, 2)
  whatsappPayload String
  status          SnackListStatus @default(draft)
  createdAt       DateTime        @default(now())

  items SnackListItem[]

  @@index([userId])
}

model SnackListItem {
  id          String    @id @default(cuid())
  snackListId String
  snackList   SnackList @relation(fields: [snackListId], references: [id], onDelete: Cascade)
  snackId     String
  snack       Snack     @relation(fields: [snackId], references: [id])
  name        String
  quantity    Int
  price       Decimal   @db.Decimal(10, 2)
}

/// M10b seller-side stand-in for a real inbound WhatsApp order — see
/// lib/types/food.ts's doc comment. M9's WhatsApp Cloud API ingestion is
/// expected to create these rows from real inbound messages without a
/// shape change.
model SnackOrder {
  id            String            @id @default(cuid())
  sellerId      String
  seller        Seller            @relation(fields: [sellerId], references: [id])
  customerName  String
  customerPhone String
  total         Decimal           @db.Decimal(10, 2)
  channel       SnackOrderChannel @default(whatsapp)
  status        SnackOrderStatus  @default(received)
  createdAt     DateTime          @default(now())

  items SnackOrderItem[]

  @@index([sellerId])
}

model SnackOrderItem {
  id           String     @id @default(cuid())
  snackOrderId String
  snackOrder   SnackOrder @relation(fields: [snackOrderId], references: [id], onDelete: Cascade)
  snackId      String
  snack        Snack      @relation(fields: [snackId], references: [id])
  name         String
  quantity     Int
  price        Decimal    @db.Decimal(10, 2)
}

model MealPromo {
  id                String  @id @default(cuid())
  title             String
  description       String
  imagePlaceholder  String
  imageSrc          String?
  appStoreUrl       String
  playStoreUrl      String
  qrCodePlaceholder String
}

// ---------------------------------------------------------------------------
// Seller portal (M10) — Seller/Payout live here now (schema only); real
// seller-scoped endpoints are M8.3.
// ---------------------------------------------------------------------------

/// A HomeKrafter — the single supply-side role. There is no longer a
/// maker/laundry/snack split: one account type, one portal, every module
/// available to everyone. What a HomeKrafter actually does is described by
/// `specialties`, which is never consulted for authorization.
model Seller {
  id          String            @id @default(cuid())
  userId      String            @unique
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// What this kitchen/business offers. Discovery only — see `SellerSpecialty`.
  specialties SellerSpecialty[]
  /// Every HomeKrafter has a storefront now (it's how buyers find them and
  /// where their items hang), so this is required rather than maker-only.
  vendorId    String            @unique
  vendor      Vendor            @relation(fields: [vendorId], references: [id])
  displayName String
  status      SellerStatus      @default(pending)
  createdAt   DateTime          @default(now())
  rating      Decimal?          @db.Decimal(2, 1)
  reviewCount Int?

  payouts         Payout[]
  laundryBookings LaundryBooking[]
  snacks          Snack[]
  snackOrders     SnackOrder[]
  mealPlans       MealPlan[]

  @@index([status])
}

/// M16 (M5). Platform-wide settings an admin can change **without a
/// redeploy**. Before this, the commission rate existed nowhere, the
/// default delivery radius was a constant, and feature flags lived in
/// `client/lib/features.ts` — a build-time constant, so holding or
/// releasing a feature meant shipping a build.
///
/// A single-row table would have been simpler; a key/value one is used
/// because each setting is read by a different part of the system and a
/// wide row would mean every reader pulling every column. Values are
/// stored as text and parsed by `AdminSettingsService`, which owns the
/// schema — a `Json` column would move the same parsing problem without
/// making it typed.
///
/// **Nothing is stored here that nothing reads.** A settings screen full
/// of decorative knobs is worse than no settings screen: it implies
/// changes take effect.
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  /// Who last changed it. Every write is also an `AdminAuditLog` row —
  /// this is the cheap "when was this last touched" read.
  updatedBy String?
}

model Payout {
  id          String       @id @default(cuid())
  sellerId    String
  seller      Seller       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  amount      Decimal      @db.Decimal(12, 2)
  periodStart DateTime
  periodEnd   DateTime
  status      PayoutStatus @default(pending)
  paidAt      DateTime?
  /// The bank/UPI reference the money actually moved under (a UTR, a
  /// transaction id). Recorded because settlement happens **outside this
  /// system** — there is no payout-provider integration — so this string
  /// is the only link between "we marked it paid" and a real transfer,
  /// and it is what a HomeKrafter quotes when they say it never arrived.
  reference   String?
  /// Why it was rejected, or any note attached when settling. Shown to
  /// the HomeKrafter: a payout refused with no explanation is worse than
  /// one that never happened.
  note        String?
  /// Which admin settled or refused it, and when. Also written to
  /// `AdminAuditLog`; kept on the row too so the payout itself can say
  /// who touched it without a join across a loosely-typed log table.
  decidedById String?
  decidedBy   User?        @relation("PayoutDecidedBy", fields: [decidedById], references: [id])
  decidedAt   DateTime?

  @@index([sellerId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Admin (M8.3c) — not a `lib/types` entity (no frontend mock equivalent);
// added fresh for the real backend per the M8.3c brief's "every admin
// mutation writes an audit row" requirement. `actorId` is always the
// acting admin's own `User.id` (never client-supplied — resolved from
// `@CurrentUser()` the same way every other actor id in this schema is).
// `targetType`/`targetId` are a loose (not FK-enforced) pointer at
// whatever row the action touched (`User`, `Seller`, `SellerApplication`,
// `Product`, `Review`, `Order`, `LaundryBooking`, `Wallet`, `Collection`,
// ...) — deliberately not a real relation, since one log table spans many
// unrelated target tables and a dangling reference (e.g. after a rare
// hard-delete) should never block writing the log itself. `metadata` is
// a free-form JSON blob for action-specific detail (e.g. `{ amount,
// reason }` for a wallet adjustment) kept out of `action`/`targetId` so
// `GET /admin/audit` can render a readable one-line summary per row.
// ---------------------------------------------------------------------------

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Meal subscriptions (M19)
//
// The recurring product the platform did not have. Two things about the
// shape are load-bearing and easy to undo:
//
// 1. **A cycle is PREPAID.** There is no payment mandate — `creditTopupTx`
//    is reachable only from the verified Razorpay webhook, and the
//    auto-top-up path that pretended otherwise is exactly the bug M19
//    opened with. So a buyer pays for N meals up front out of wallet
//    balance, in one debit, and the subscription spends that down. Nothing
//    charges anybody in the background. When UPI AutoPay lands, `amountPaid`
//    plus `mealsRemaining` is the seam to convert against.
//
// 2. **Every meal is a row.** `MealDelivery` exists so that skip, pause and
//    a kitchen's blackout day are all recorded facts rather than arithmetic
//    on a counter. A counter would make "why do I have 11 meals left when I
//    paid for 14" unanswerable, which on a daily-food product is the
//    question that gets asked.
// ---------------------------------------------------------------------------

/// What a kitchen offers on a recurring basis. Distinct from `Product` and
/// `Snack`: those are bought once, this is subscribed to, and the fields
/// that matter here (how many subscribers a home cook can carry, what a
/// week's rotation looks like) have no meaning on a one-off listing.
model MealPlan {
  id       String @id @default(cuid())
  slug     String @unique
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  /// Required, unlike `Snack.sellerId`. A subscription commits a kitchen to
  /// cooking on a schedule, so a plan whose fulfilment owner is unknown
  /// cannot be honoured — and a nullable column here would let one be
  /// created and only fail on the first delivery.
  sellerId String
  seller   Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  name        String
  description String
  mealType    MealType
  diet        DietType

  /// Per meal, not per cycle. The cycle price is this times the meal count,
  /// computed at subscribe time and snapshotted onto the subscription.
  pricePerMeal Decimal @db.Decimal(10, 2)

  /// "2 rotis, dal, sabzi, rice, salad". The single most asked question
  /// about a tiffin, and the reason a photo alone does not sell one.
  servingSize String?
  /// A week's rotation as free text, one line per day. Display only — a
  /// structured menu would need a per-date entity nobody has asked for, and
  /// home kitchens cook to what the market had.
  weeklyMenu  String[]

  imagePlaceholder String
  imageSrc         String?

  /// The kitchen's own switch, same split as `Product.isAvailable` vs
  /// `moderationStatus`: this is "am I taking subscribers", that is the
  /// admin's. A buyer needs both to pass. Merging them would let a
  /// moderator's action be silently undone by a cook toggling availability.
  isActive         Boolean                 @default(true)
  moderationStatus ProductModerationStatus @default(active)

  /// The ceiling a home cook can actually cook to. `VendorProfile.capacityPerDay`
  /// has existed since M16 and is enforced nowhere; this one is checked on
  /// every subscribe. Null means unlimited, which is a deliberate choice a
  /// kitchen makes rather than a default they never saw.
  maxSubscribers Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions MealSubscription[]

  @@index([vendorId])
  @@index([sellerId])
  @@index([mealType, isActive])
}

/// One buyer's prepaid run of meals from one plan.
model MealSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId String
  plan   MealPlan @relation(fields: [planId], references: [id])

  /// Required. A meal has to go somewhere, and the review of the held plan
  /// found the original spec never set an address at all — the same defect
  /// that makes `OrderItem.addressId` required.
  addressId String
  address   Address @relation(fields: [addressId], references: [id])

  /// Start of the 30-minute window, "HH:MM" local, e.g. "12:30" meaning
  /// 12:30–13:00. A string for the same reason `LaundrySlot` windows are:
  /// it is a label the kitchen and the buyer agree on, not an instant, and
  /// storing it as a timestamp would silently move it across a DST-free
  /// timezone change nobody asked for.
  bracketStart String

  /// 0 = Sunday. Which days of the week this subscription runs.
  daysOfWeek Int[]

  status MealSubscriptionStatus @default(active)

  /// **Snapshot at subscribe time**, never re-read from the plan. Reading
  /// `MealPlan.pricePerMeal` fresh each cycle would protect the kitchen and
  /// silently change what the buyer pays — for a daily-food product that is
  /// the worst possible surprise. A price rise applies at renewal, where
  /// the buyer sees it before agreeing.
  pricePerMeal Decimal @db.Decimal(10, 2)
  /// What was actually debited from the wallet for this cycle.
  amountPaid   Decimal @db.Decimal(10, 2)

  mealsTotal     Int
  /// Decremented only on `delivered`. A skipped or unavailable meal stays
  /// owed, which is what makes the count answerable.
  mealsRemaining Int

  startDate DateTime @db.Date
  /// Moves outward every time a meal is skipped or the kitchen is closed —
  /// the buyer paid for a number of meals, not a number of days.
  endDate   DateTime @db.Date

  pausedAt    DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  deliveries MealDelivery[]

  @@index([userId, status])
  @@index([planId, status])
}

/// One scheduled meal. The kitchen's work queue and the buyer's receipt.
model MealDelivery {
  id             String           @id @default(cuid())
  subscriptionId String
  subscription   MealSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  /// Date only, UTC midnight — the window lives in `bracketStart`.
  scheduledFor DateTime           @db.Date
  bracketStart String
  status       MealDeliveryStatus @default(scheduled)

  /// Why it isn't happening. A blackout's reason is copied here at the time
  /// so the buyer's history still explains itself after the kitchen clears
  /// its calendar.
  reason String?

  skippedAt   DateTime?
  deliveredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One meal per subscription per day. The uniqueness is what makes the
  /// scheduler safe to re-run.
  @@unique([subscriptionId, scheduledFor])
  @@index([scheduledFor, status])
}
